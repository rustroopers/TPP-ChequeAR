# Procesado por envsubst al arrancar el contenedor: sólo se reemplazan las variables de
# entorno definidas (TERM_KEY); $expand, $http_... y demás quedan literales para nginx.
# La key tiene 64 caracteres: con el bucket default (64) nginx no puede armar el hash.
map_hash_bucket_size 128;

map $http_x_chequear_key $key_ok {
    default        0;
    "${TERM_KEY}"  1;
}

limit_req_zone $binary_remote_addr zone=term:10m rate=20r/s;

server {
    listen 443 ssl default_server;
    http2 on;
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Segunda capa además de la Security List de OCI. Las IPs de salida de un App Service
    # F1 son compartidas con otros clientes de Azure: por eso además se exige la key.
    include /etc/nginx/azure-allow.conf;
    deny all;

    if ($key_ok = 0) { return 403; }

    limit_req zone=term burst=40 nodelay;
    client_max_body_size 1k;

    location = /fhir/metadata {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8080;
    }

    location = /fhir/ValueSet/$expand {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8080;
        proxy_read_timeout 30s;
    }

    # Todo lo demás (dashboard, /fhir-admin, escritura de ValueSets, MCP) no sale.
    location / { return 404; }
}
