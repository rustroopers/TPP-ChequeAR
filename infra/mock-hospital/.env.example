# Mock Hospital DB — variables de entorno para desarrollo local.
# Copiar este archivo a `.env` (mismo directorio) antes de `docker compose up`.
# Estos valores son sólo para desarrollo local. No deben portarse a otros entornos.

# Password del usuario SYS de Oracle. Lo usa el contenedor para bootstrap.
ORACLE_PASSWORD=oraclesys

# Password del owner del schema mock. Sólo los scripts de init la usan.
HOSPITAL_MOCK_PASSWORD=hospitalmockdev

# Password del usuario read-only consumido por OracleViewClient.
# Debe coincidir con la connection string `OracleHospitalView` del Web.config.
CHEQUEAR_RO_PASSWORD=devdev
