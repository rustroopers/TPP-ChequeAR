# Copiar a .env y ajustar según la RAM de la máquina.
# Elasticsearch: heap para el índice. 4g entra la International Edition completa.
# Bajar a 2g si la máquina tiene < 8 GB libres (el import tarda más).
ES_HEAP=4g

# Snowstorm: heap de la app. 4g es holgado para búsqueda/$expand.
SNOWSTORM_HEAP=4g
