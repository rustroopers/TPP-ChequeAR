[*.cs]
# La convencion de nombres de test de este proyecto es Metodo_Escenario_Resultado (ver
# QuestionnaireTests.cs, SavedReportServiceTests.cs, etc.) - CA1707 (sin guion bajo) la
# contradice directamente. Sigue activa en Domain/Application/Infrastructure/Api.
dotnet_diagnostic.CA1707.severity = none

# CA1861 (extraer arrays constantes a un campo static readonly) es una recomendacion de
# rendimiento para hot paths. En tests el array literal vive al lado del Assert que lo usa
# a proposito -moverlo a un campo aparte de la clase perjudica la lectura del caso, no la
# mejora- y ningun test corre en un loop caliente.
dotnet_diagnostic.CA1861.severity = none

# xUnit nombra las definiciones de colección con el sufijo Collection.
dotnet_diagnostic.CA1711.severity = none
