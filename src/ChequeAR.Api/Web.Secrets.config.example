<?xml version="1.0" encoding="utf-8"?>
<!-- Copiar como Web.Secrets.config (sin ".example") y completar con valores reales.
     Web.Secrets.config NO se versiona (ver .gitignore). -->
<appSettings>
  <add key="Jwt:SigningSecret" value="REPLACE_WITH_ENV_OR_DPAPI_PROTECTED_SECRET" />
  <add key="Oracle:ConnectionString" value="User Id=CHEQUEAR_RO;Password=REPLACE_ME;Data Source=localhost:1521/XEPDB1;" />
  <!-- Habilita el fallback de login en modo debug cuando el hospital no responde (ver AccountController).
       Dejar en "true" solo en máquinas de desarrollo; nunca en un entorno compartido. -->
  <add key="Auth:AllowDebugLoginFallback" value="false" />
</appSettings>
