<?xml version="1.0" encoding="utf-8"?>
<!--
  Transformaciones que se aplican al publicar en Release. NO afectan el
  Web.config de desarrollo: se aplican sobre una copia, al empaquetar.

  Las dos son requisito para exponer la app en una URL publica.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="Logging:Root" value="%HOME%\LogFiles\chequear"
         xdt:Transform="SetAttributes(value)" xdt:Locator="Match(key)" />
    <add key="Attachments:Root" value="%HOME%\data\chequear\attachments"
         xdt:Transform="SetAttributes(value)" xdt:Locator="Match(key)" />
    <!-- La contrasena de los usuarios de demo NUNCA viaja en el paquete publicado: se
         blanquea acá y se configura como Application Setting en el portal de Azure. Vacía
         => Configuration.SeedDemoUsers crea los 13 usuarios igual, pero con PasswordHash
         null (fail-closed: ninguno puede loguearse hasta que se configure el App Setting). -->
    <add key="Seed:DemoPassword" value=""
         xdt:Transform="SetAttributes(value)" xdt:Locator="Match(key)" />
  </appSettings>

  <system.web>
    <!--
      Saca debug="true": en release no se sirven stack traces ni se compila sin
      optimizar. Ya no gobierna el meta cq-token (ese token ahora se emite para
      cualquier sesion iniciada y lleva los roles reales del ticket, ver
      SessionToken).

      Se usa RemoveAttributes y no Replace para no pisar el <assemblies> que
      declara netstandard 2.0 - sin ese add, las vistas Razor no compilan.
    -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />

    <!--
      mode="Off" muestra el stack trace completo ante cualquier excepcion.
      "On" sirve la vista de ErrorController a todo el mundo, incluido quien
      navegue desde el propio server.
    -->
    <customErrors mode="On" defaultRedirect="~/Error" xdt:Transform="Replace" />
  </system.web>

  <system.webServer>
    <!-- HSTS sólo en Release: en localhost afectaría a otros proyectos. -->
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000" xdt:Transform="Insert" />
      </customHeaders>
    </httpProtocol>
    <!-- Redirección a https sin depender de "HTTPS Only" en el portal de Azure. -->
    <rewrite xdt:Transform="Insert">
      <rules>
        <rule name="Forzar HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
