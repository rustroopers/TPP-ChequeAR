<?xml version="1.0" encoding="utf-8"?>
<!--
  Transformaciones que se aplican al publicar en Release. NO afectan el
  Web.config de desarrollo: se aplican sobre una copia, al empaquetar.

  Las dos son requisito para exponer la app en una URL publica.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <!--
      Saca debug="true". Sin esto, HttpContext.IsDebuggingEnabled queda en true
      y _Layout.cshtml estampa en el HTML un JWT con rol Administrador (ver
      DevToken.IssueFor): cualquier visitante anonimo lo lee del codigo fuente.
      Al quitar el atributo, el meta cq-token deja de renderizarse.

      Se usa RemoveAttributes y no Replace para no pisar el <assemblies> que
      declara netstandard 2.0 — sin ese add, las vistas Razor no compilan.
    -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />

    <!--
      mode="Off" muestra el stack trace completo ante cualquier excepcion.
      "On" sirve la vista de ErrorController a todo el mundo, incluido quien
      navegue desde el propio server.
    -->
    <customErrors mode="On" defaultRedirect="~/Error" xdt:Transform="Replace" />
  </system.web>
</configuration>
