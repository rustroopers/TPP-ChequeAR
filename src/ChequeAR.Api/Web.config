<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <!-- ChequeAR -->
    <add key="Jwt:Issuer" value="https://chequear.garrahan" />
    <add key="Jwt:Audience" value="chequear-api" />
    <add key="Jwt:SigningSecret" value="REPLACE_WITH_ENV_OR_DPAPI_PROTECTED_SECRET_DEV_ONLY" />
    <add key="Jwt:AccessTtlMinutes" value="60" />
    <add key="Jwt:RefreshTtlHours" value="8" />
    <add key="HospitalAuth:LoginUrl" value="http://localhost:9000/login" />
    <add key="HospitalFhir:BaseUrl" value="http://localhost:18080/fhir" />
    <add key="Oracle:ConnectionString" value="User Id=chequear_ro;Password=;Data Source=localhost:1521/XEPDB1;" />
    <add key="Attachments:Root" value="C:\ChequeAR\Attachments" />
    <add key="Attachments:MaxBytes" value="10485760" />
  </appSettings>
  <connectionStrings>
    <add name="ChequeAR" connectionString="Server=(localdb)\MSSQLLocalDB;Database=ChequeAR;Trusted_Connection=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.1" />
    <httpRuntime targetFramework="4.7.1" maxRequestLength="20480" />
    <customErrors mode="Off" />
    <authentication mode="None" />
  </system.web>
  <system.webServer>
    <modules>
      <remove name="FormsAuthentication" />
    </modules>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
