@{
    var pageId = ViewBag.PageId as string ?? "";
    var pageTitle = ViewBag.Title as string ?? "ChequeAR";
    var lang = (Request.Cookies["chequear_lang"] != null ? Request.Cookies["chequear_lang"].Value : "es-AR");
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle · ChequeAR</title>

    @* Dev-only: token Bearer para que las islas llamen a la API sin login del hospital. *@
    @if (System.Web.HttpContext.Current != null && System.Web.HttpContext.Current.IsDebuggingEnabled)
    {
        <meta name="cq-token" content="@ChequeAR.Api.Auth.DevToken.IssueFor(User)" />
    }

    @* TODO prod: vendor a wwwroot/lib/ y servir local (spec 006 NFR-FE assumptions). *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/Content/theme/chequear-theme.css" rel="stylesheet" />
</head>
<body>
    @Html.Partial("_ProgressBar")
    <div class="cq-app">
        @Html.Partial("_Navbar")
        @Html.Partial("_Sidebar", (object)pageId)

        <main class="cq-content" id="main">
            @Html.Partial("_DataError")
            @RenderBody()
        </main>
    </div>

    @Html.Partial("_Toasts")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/cq-date-range.js"></script>
    <script src="~/Scripts/cq-autofilter.js"></script>
    <script>
        // Sidebar: en desktop (>1024px) colapsa a modo íconos y persiste en
        // localStorage. En mobile (<=1024px) la sidebar es un drawer off-canvas:
        // el mismo toggle abre/cierra `cq-sidebar-open` (sin persistir: no tiene
        // sentido reabrirlo automáticamente en la próxima navegación), y un click
        // fuera o en un item la cierra. Antes en mobile el sidebar estaba oculto y
        // no había manera de navegar.
        (function () {
            var KEY = "cq.sidebar.collapsed";
            var root = document.body;
            var mq = window.matchMedia("(max-width: 1024px)");
            var stored = null;
            try { stored = localStorage.getItem(KEY); } catch (e) {}
            if (stored === "1" && !mq.matches) root.classList.add("cq-sidebar-collapsed");

            document.addEventListener("click", function (e) {
                var btn = e.target.closest("#cqSidebarToggle");
                if (btn) {
                    if (mq.matches) {
                        root.classList.toggle("cq-sidebar-open");
                    } else {
                        var isCollapsed = root.classList.toggle("cq-sidebar-collapsed");
                        try { localStorage.setItem(KEY, isCollapsed ? "1" : "0"); } catch (e) {}
                    }
                    return;
                }
                // Backdrop / item clickeado: en mobile cerramos el drawer.
                if (mq.matches && root.classList.contains("cq-sidebar-open")) {
                    var insideSidebar = e.target.closest(".cq-sidebar");
                    if (!insideSidebar || e.target.closest(".cq-sidebar__item")) {
                        root.classList.remove("cq-sidebar-open");
                    }
                }
            });

            // Al cruzar el breakpoint limpiamos el estado que no corresponde al
            // nuevo modo (drawer abierto no tiene sentido en desktop y viceversa).
            mq.addEventListener("change", function () {
                root.classList.remove("cq-sidebar-open");
                if (mq.matches) root.classList.remove("cq-sidebar-collapsed");
                else if (stored === "1") root.classList.add("cq-sidebar-collapsed");
            });
        })();

        // Bootstrap tooltips — activa todo [data-bs-toggle="tooltip"] al cargar.
        document.addEventListener("DOMContentLoaded", function () {
            if (!window.bootstrap || !bootstrap.Tooltip) return;
            var els = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            Array.prototype.forEach.call(els, function (el) {
                new bootstrap.Tooltip(el, { delay: { show: 400, hide: 80 } });
            });
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
