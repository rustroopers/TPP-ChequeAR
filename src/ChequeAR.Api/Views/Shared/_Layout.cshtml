@{
    var pageId = ViewBag.PageId as string ?? "";
    var pageTitle = ViewBag.Title as string ?? "ChequeAR";
    var lang = (Request.Cookies["chequear_lang"] != null ? Request.Cookies["chequear_lang"].Value : "es-AR");
    // Cache-busting para assets locales: appendea ?v=<mtime> así cualquier cambio
    // se ve con F5 normal en dev, sin necesidad de Ctrl+F5. En prod tampoco molesta:
    // el navegador cachea normal hasta que el archivo cambie.
    Func<string, string> asset = path => {
        try { return Url.Content(path) + "?v=" + System.IO.File.GetLastWriteTimeUtc(Server.MapPath(path)).Ticks; }
        catch { return Url.Content(path); }
    };
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ChequeAR</title>
    <link rel="icon" type="image/png" href="@asset("~/Content/img/favicon-512.png")" />

    @* Token Bearer para que las islas Vue llamen a la API. Solo para sesion iniciada:
       lleva los roles reales del ticket, asi que no habilita nada que la persona no pueda
       ya hacer. Sin login no se estampa y las islas avisan "token ausente". *@
    @if (Request.IsAuthenticated)
    {
        <meta name="cq-token" content="@ChequeAR.Api.Auth.SessionToken.IssueFor(User)" />
        @* El rol propio, no un secreto: el usuario ya sabe cuál es. Sirve para que las
           islas Vue (p. ej. questionnaire-editor) decidan qué mostrar sin tener que
           decodificar el JWT. La autorización real sigue del lado del server. *@
        <meta name="cq-role" content="@ChequeAR.Api.Auth.CurrentUser.PrincipalRole(User as System.Security.Claims.ClaimsPrincipal)" />
    }

    @* TODO prod: vendor a wwwroot/lib/ y servir local (spec 006 NFR-FE assumptions). *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="@asset("~/Content/theme/chequear-theme.css")" rel="stylesheet" />
</head>
<body>
    @Html.Partial("_ProgressBar")
    <div class="cq-app">
        @Html.Partial("_Navbar")
        @Html.Partial("_Sidebar", (object)pageId)

        <main class="cq-content" id="main">
            @Html.Partial("_DataError")
            @RenderBody()
        </main>
    </div>

    @Html.Partial("_Toasts")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@asset("~/Scripts/cq-date-range.js")"></script>
    <script src="@asset("~/Scripts/cq-autofilter.js")"></script>
    <script src="@asset("~/Scripts/cq-select-enhance.js")"></script>
    <script>
        // Sidebar: en desktop (>1024px) colapsa a modo íconos y persiste en
        // localStorage. En mobile (<=1024px) la sidebar es un drawer off-canvas:
        // el mismo toggle abre/cierra `cq-sidebar-open` (sin persistir: no tiene
        // sentido reabrirlo automáticamente en la próxima navegación), y un click
        // fuera o en un item la cierra. Antes en mobile el sidebar estaba oculto y
        // no había manera de navegar.
        (function () {
            // Ya no hay hamburguesa: en desktop la sidebar siempre queda
            // colapsada y se expande al hover. En mobile queda como estaba
            // (drawer off-canvas — sin toggle por ahora).
            var root = document.body;
            var mq = window.matchMedia("(max-width: 1024px)");
            if (!mq.matches) root.classList.add("cq-sidebar-collapsed");

            // Fresh page load en desktop: si el usuario venia clickeando un
            // item de la sidebar (o entra con el mouse ya sobre ella), el
            // :hover CSS dispararia la expansion apenas se mueva un pixel.
            // Aplicamos force-collapse hasta la primera "salida real" del
            // sidebar — mouseleave si estaba dentro, o mousemove fuera del
            // sidebar si nunca estuvo — y ahi limpiamos para que el siguiente
            // hover expanda normal.
            if (!mq.matches) {
                var initSb = document.querySelector(".cq-sidebar");
                if (initSb) {
                    initSb.classList.add("cq-sidebar--force-collapse");
                    var clearFn = function () {
                        initSb.classList.remove("cq-sidebar--force-collapse");
                        initSb.removeEventListener("mouseleave", clearFn);
                        document.removeEventListener("mousemove", maybeClear);
                    };
                    var maybeClear = function (ev) {
                        if (!initSb.contains(ev.target)) clearFn();
                    };
                    initSb.addEventListener("mouseleave", clearFn);
                    document.addEventListener("mousemove", maybeClear);
                }
            }

            document.addEventListener("click", function (e) {
                // Al clickear un item, forzamos colapso visual inmediato antes
                // de que arranque la navegación. La clase se limpia sola al
                // sacar el cursor para no bloquear el próximo hover.
                if (!mq.matches && root.classList.contains("cq-sidebar-collapsed")) {
                    var item = e.target.closest(".cq-sidebar__item");
                    if (item) {
                        var sb = document.querySelector(".cq-sidebar");
                        if (sb) {
                            sb.classList.add("cq-sidebar--force-collapse");
                            sb.addEventListener("mouseleave", function onLeave() {
                                sb.classList.remove("cq-sidebar--force-collapse");
                                sb.removeEventListener("mouseleave", onLeave);
                            });
                        }
                    }
                }
            });

            mq.addEventListener("change", function () {
                if (mq.matches) root.classList.remove("cq-sidebar-collapsed");
                else root.classList.add("cq-sidebar-collapsed");
            });
        })();

        // Bootstrap tooltips — activa todo [data-bs-toggle="tooltip"] al cargar.
        // Los tooltips ahora se reservan para etiquetar íconos sin texto (Acciones,
        // Quitar código, sidebar colapsada). Los textos de ayuda de más de una línea
        // van a un botón "?" con popover (ver abajo) porque el feedback fue que el
        // hover del item padre era intrusivo.
        document.addEventListener("DOMContentLoaded", function () {
            if (!window.bootstrap || !bootstrap.Tooltip) return;
            var els = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            Array.prototype.forEach.call(els, function (el) {
                new bootstrap.Tooltip(el, { delay: { show: 400, hide: 80 } });
            });
        });

        // Popovers de ayuda: se disparan sólo desde el botón "?" y aceptan tanto
        // hover como click (el hover ayuda a exploradores; el click garantiza
        // acceso desde touch/teclado).
        // NO combinar 'click' con 'hover'/'focus' en el trigger de Bootstrap: es
        // un bug conocido que deja el popover "pegado" sin cerrarse (el toggle
        // interno de click y el show/hide de hover/focus pisan el mismo estado).
        // 'focus' solo ya cubre click (el botón recibe foco al clickearlo) y
        // cierra al perder el foco (click afuera, Tab, Esc); el hover se agrega
        // a mano solo para mostrar, sin interferir con ese cierre.
        document.addEventListener("DOMContentLoaded", function () {
            if (!window.bootstrap || !bootstrap.Popover) return;
            var els = document.querySelectorAll('[data-bs-toggle="popover"]');
            Array.prototype.forEach.call(els, function (el) {
                var popover = new bootstrap.Popover(el, {
                    trigger: 'focus',
                    html: false,
                    container: 'body'
                });
                el.addEventListener("mouseenter", function () { popover.show(); });
                el.addEventListener("mouseleave", function () {
                    if (document.activeElement !== el) popover.hide();
                });
            });
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
