@model string
@{
    var active = Model ?? "";
    Func<string, string> cls = id => active == id ? "cq-sidebar__item is-active" : "cq-sidebar__item";
}
@* Cambios de la Etapa 2:
   - Íconos y texto más grandes.
   - Cada item lleva tooltip: útil cuando la sidebar está colapsada.
   - Ícono de Pacientes: se cambia bi-person-vcard por bi-person-heart, más
     acorde a un contexto de historia clínica pediátrica (feedback D1). *@
<nav class="cq-sidebar" aria-label="@Cq.T("navbar.brand")">
    <div class="cq-sidebar__inner">
        <div class="cq-sidebar__group-label">@Cq.T("sidebar.group.work")</div>
        <a class="@cls("home")" href="@Url.Action("Index", "Home")" data-bs-toggle="tooltip" data-bs-placement="right" title="@Cq.T("sidebar.home")">
            <i class="bi bi-house-door"></i> <span class="cq-sidebar__label">@Cq.T("sidebar.home")</span>
        </a>
        <a class="@cls("encounters")" href="@Url.Action("Search", "Encounters")" data-bs-toggle="tooltip" data-bs-placement="right" title="@Cq.T("sidebar.patients") — buscá una historia clínica para cargar una ficha o ver el historial">
            <i class="bi bi-person-heart"></i> <span class="cq-sidebar__label">@Cq.T("sidebar.patients")</span>
        </a>
        <a class="@cls("questionnaires")" href="@Url.Action("Index", "Questionnaires")" data-bs-toggle="tooltip" data-bs-placement="right" title="@Cq.T("sidebar.questionnaires") — crear, editar y publicar los formularios de tu servicio">
            <i class="bi bi-clipboard2-pulse"></i> <span class="cq-sidebar__label">@Cq.T("sidebar.questionnaires")</span>
        </a>
        <a class="@cls("reports")" href="@Url.Action("Index", "Reports")" data-bs-toggle="tooltip" data-bs-placement="right" title="@Cq.T("sidebar.reports") — indicadores agregados de las fichas cargadas">
            <i class="bi bi-bar-chart"></i> <span class="cq-sidebar__label">@Cq.T("sidebar.reports")</span>
        </a>

        <div class="cq-sidebar__group-label">@Cq.T("sidebar.group.admin")</div>
        <a class="@cls("audit")" href="@Url.Action("Index", "Audit")" data-bs-toggle="tooltip" data-bs-placement="right" title="@Cq.T("sidebar.audit")">
            <i class="bi bi-shield-check"></i> <span class="cq-sidebar__label">@Cq.T("sidebar.audit")</span>
        </a>
        <a class="@cls("users")" href="@Url.Action("Index", "Users")" data-bs-toggle="tooltip" data-bs-placement="right" title="@Cq.T("sidebar.users")">
            <i class="bi bi-people"></i> <span class="cq-sidebar__label">@Cq.T("sidebar.users")</span>
        </a>
    </div>
</nav>
