@model string
@using ChequeAR.Domain.Enums
@{
    var active = Model ?? "";
    Func<string, string> cls = id => active == id ? "cq-sidebar__item is-active" : "cq-sidebar__item";
    // Cosmético: la autorización real es RequiresPermission(Api)Attribute + IAccessGuard.
    // Esto sólo evita mostrarle a un Medico un link que va a terminar en un 403 -antes el
    // menú era estático y TODOS veían Auditoría/Usuarios sin importar su rol.
    var canSeeReports = Cq.Can(Permissions.ReportRead);
    var canSeeAudit = Cq.Can(Permissions.AuditRead);
    var canSeeUsers = Cq.Can(Permissions.UserManage);
    var canSeeVariables = Cq.Can(Permissions.VariableManage);
}
@* Cambios de la Etapa 2:
   - Íconos y texto más grandes.
   - Cada item lleva tooltip: útil cuando la sidebar está colapsada.
   - Ícono de Pacientes: se cambia bi-person-vcard por bi-person-heart, más
     acorde a un contexto de historia clínica pediátrica (feedback D1). *@
<nav class="cq-sidebar" aria-label="@Cq.T("navbar.brand")">
    <div class="cq-sidebar__inner">
        <div class="cq-sidebar__group-label">@Cq.T("sidebar.group.work")</div>
        <a class="@cls("home")" href="@Url.Action("Index", "Home")">
            <i class="bi bi-house-door"></i> <span class="cq-sidebar__label">@Cq.T("sidebar.home")</span>
        </a>
        <a class="@cls("encounters")" href="@Url.Action("Index", "Encounters")">
            <i class="bi bi-person-heart"></i> <span class="cq-sidebar__label">@Cq.T("sidebar.patients")</span>
        </a>
        <a class="@cls("questionnaires")" href="@Url.Action("Index", "Questionnaires")">
            <i class="bi bi-clipboard2-pulse"></i> <span class="cq-sidebar__label">@Cq.T("sidebar.questionnaires")</span>
        </a>
        @if (canSeeReports)
        {
            <a class="@cls("reports")" href="@Url.Action("Index", "Reports")">
                <i class="bi bi-bar-chart"></i> <span class="cq-sidebar__label">@Cq.T("sidebar.reports")</span>
            </a>
        }

        @if (canSeeAudit || canSeeUsers || canSeeVariables)
        {
            <div class="cq-sidebar__group-label">@Cq.T("sidebar.group.admin")</div>
            if (canSeeAudit)
            {
                <a class="@cls("audit")" href="@Url.Action("Index", "Audit")">
                    <i class="bi bi-shield-check"></i> <span class="cq-sidebar__label">@Cq.T("sidebar.audit")</span>
                </a>
            }
            if (canSeeUsers)
            {
                <a class="@cls("users")" href="@Url.Action("Index", "Users")">
                    <i class="bi bi-people"></i> <span class="cq-sidebar__label">@Cq.T("sidebar.users")</span>
                </a>
            }
            if (canSeeVariables)
            {
                <a class="@cls("variables")" href="@Url.Action("Index", "Variables")">
                    <i class="bi bi-tags"></i> <span class="cq-sidebar__label">@Cq.T("sidebar.variables")</span>
                </a>
            }
        }
    </div>
</nav>
