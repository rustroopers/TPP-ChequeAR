@{
    var userName = User != null && User.Identity != null && User.Identity.IsAuthenticated
        ? User.Identity.Name
        : "Invitado";
}
<header class="cq-navbar" role="banner">
    <a href="@Url.Action("Index", "Home")" class="cq-navbar__brand" aria-label="@Cq.T("navbar.brand") — @Cq.T("sidebar.home")">
        @* TODO prod: vendor el logo a Content/img/garrahan-logo-white.svg *@
        <img src="https://www.garrahan.gov.ar/images/logo2.png" alt="Hospital Garrahan" />
        <span>@Cq.T("navbar.brand")</span>
    </a>

    <div class="cq-navbar__spacer"></div>

    <div class="cq-navbar__actions">
        <div class="dropdown">
            <button class="cq-navbar__btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle"></i>
                <span>@userName</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                @if (Request.IsAuthenticated)
                {
                    <li><a class="dropdown-item" href="@Url.Action("Profile", "Account")"><i class="bi bi-person"></i> @Cq.T("navbar.profile")</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account")"><i class="bi bi-box-arrow-right"></i> @Cq.T("navbar.logout")</a></li>
                }
                else
                {
                    @* Sin este link no hay forma de llegar al login desde la UI, y sin login
                       las islas no reciben token: la pagina carga pero no deja guardar nada. *@
                    <li><a class="dropdown-item" href="@Url.Action("Login", "Account")"><i class="bi bi-box-arrow-in-right"></i> Iniciar sesión</a></li>
                }
            </ul>
        </div>
    </div>
</header>
