@model ChequeAR.Api.Models.IntegrationsViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Integraciones";
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">Integraciones</h1>
        <p class="cq-page-header__subtitle">Salud y latencia de los sistemas conectados</p>
    </div>
    <a href="@Url.Action("Capability")" class="btn btn-outline-secondary"><i class="bi bi-code-slash me-1"></i> CapabilityStatement</a>
</header>

<div class="cq-grid cq-grid--3">
    @foreach (var ig in Model.Integrations)
    {
        <div class="cq-card">
            <div class="d-flex align-items-center gap-2 mb-2">
                @if (ig.Status == "ok") { <span class="cq-badge cq-badge--published">OK</span> }
                else if (ig.Status == "degraded") { <span class="cq-badge cq-badge--draft">Degradado</span> }
                else { <span class="cq-badge cq-badge--danger">Caído</span> }
                <h3 class="m-0">@ig.Name</h3>
            </div>
            <dl class="row mb-0 cq-text-sm">
                <dt class="col-6 cq-text-muted">Último ping</dt><dd class="col-6">@ig.LastPing</dd>
                <dt class="col-6 cq-text-muted">Latencia p95</dt><dd class="col-6">@ig.LatencyP95</dd>
            </dl>
            @if (!string.IsNullOrEmpty(ig.Detail)) { <p class="cq-text-xs cq-text-muted mt-2 mb-0">@ig.Detail</p> }
            <button class="btn btn-sm btn-outline-secondary mt-3"><i class="bi bi-arrow-clockwise me-1"></i> Reintentar</button>
        </div>
    }
</div>

<h2 class="cq-section-title">Errores recientes</h2>
<div class="cq-card">
    @if (Model.RecentErrors.Count == 0)
    {
        <p class="cq-text-sm cq-text-muted m-0">Sin errores recientes.</p>
    }
    else
    {
        <ul class="list-unstyled m-0">
            @foreach (var er in Model.RecentErrors)
            {
                <li class="cq-text-sm py-1" style="border-bottom: 1px solid var(--cq-neutral-200);">@er</li>
            }
        </ul>
    }
</div>
