@model ChequeAR.Api.Models.ProfileViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Mi perfil";
    ViewBag.PageId = "home";
    ViewBag.Breadcrumbs = new System.Collections.Generic.List<System.Tuple<string, string>>
    {
        System.Tuple.Create("Inicio", Url.Action("Index", "Home")),
        System.Tuple.Create("Mi perfil", (string)null)
    };
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">Mi perfil</h1>
        <p class="cq-page-header__subtitle">Datos institucionales y preferencias</p>
    </div>
</header>

<div class="cq-card" style="max-width:640px;">
    <h2>Datos</h2>
    <dl class="row mb-0">
        <dt class="col-sm-4 cq-text-sm cq-text-muted">Nombre</dt>
        <dd class="col-sm-8">@(Model.DisplayName ?? Model.UserName)</dd>

        <dt class="col-sm-4 cq-text-sm cq-text-muted">Usuario</dt>
        <dd class="col-sm-8">@Model.UserName</dd>

        <dt class="col-sm-4 cq-text-sm cq-text-muted">Email</dt>
        <dd class="col-sm-8">@(Model.Email ?? "—")</dd>

        <dt class="col-sm-4 cq-text-sm cq-text-muted">Especialidades</dt>
        <dd class="col-sm-8">
            @if (Model.Specialties.Count == 0)
            {
                <span class="cq-text-muted">Sin especialidad asignada</span>
            }
            else
            {
                foreach (var s in Model.Specialties)
                {
                    <span class="cq-chip cq-chip--zone-@s.Color">@s.Label</span>
                }
            }
        </dd>

        <dt class="col-sm-4 cq-text-sm cq-text-muted">Rol</dt>
        <dd class="col-sm-8">@(Model.Roles.Count > 0 ? string.Join(", ", Model.Roles) : "—")</dd>
    </dl>
</div>

<div class="cq-card mt-3" style="max-width:640px;">
    <h2>Preferencias</h2>
    @* TODO: SaveProfile hoy sólo redirige -- persistir preferencias es otra feature. *@
    @using (Html.BeginForm("SaveProfile", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="notifyEmail" name="notifyEmail" checked />
                <label class="form-check-label" for="notifyEmail">Notificaciones por email</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="notifyApp" name="notifyApp" />
                <label class="form-check-label" for="notifyApp">Notificaciones in-app</label>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
    }
</div>
