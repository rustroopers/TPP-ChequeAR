@{
    Layout = null;
    ViewBag.Title = "Sesión expirada";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sesión expirada · ChequeAR</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/theme/chequear-theme.css" rel="stylesheet" />
</head>
<body>
    <div class="cq-centered">
        <div class="cq-centered__card">
            <i class="bi bi-shield-lock" style="font-size:48px; color:var(--cq-primary-400);"></i>
            <h1 class="mt-3">Tu sesión expiró</h1>
            <p class="cq-text-muted">Ingresá tu contraseña para continuar trabajando sin perder cambios.</p>

            @using (Html.BeginForm("DoLogin", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="text-start">
                    <div class="mb-3">
                        <label class="form-label cq-text-sm cq-text-muted">Usuario</label>
                        <input type="text" class="form-control" value="@(User != null && User.Identity != null ? User.Identity.Name : "")" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contraseña</label>
                        <input type="password" name="password" class="form-control" autofocus required />
                    </div>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <a href="@Url.Action("Logout", "Account")" class="btn btn-outline-secondary flex-fill">Cerrar sesión</a>
                    <button type="submit" class="btn btn-primary flex-fill">Continuar</button>
                </div>
            }
        </div>
    </div>
</body>
</html>
