@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.PageId = "home";
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">Cambiar contraseña</h1>
        <p class="cq-page-header__subtitle">Se cierran todas sus sesiones abiertas</p>
    </div>
</header>

<div class="cq-card" style="max-width:480px;">
    @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        var error = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).FirstOrDefault();
        if (error != null)
        {
            <div class="alert alert-danger cq-text-sm py-2 px-3 mb-3" role="alert">@error</div>
        }
        <div class="mb-3">
            <label for="current" class="form-label">Contraseña actual</label>
            <input type="password" id="current" name="current" class="form-control" autocomplete="current-password" required autofocus />
        </div>
        <div class="mb-3">
            <label for="replacement" class="form-label">Nueva contraseña</label>
            <input type="password" id="replacement" name="replacement" class="form-control" autocomplete="new-password"
                   minlength="@ChequeAR.Application.Services.UserService.MinPasswordLength" required aria-describedby="replacementHelp" />
            <div id="replacementHelp" class="form-text">Al menos @ChequeAR.Application.Services.UserService.MinPasswordLength caracteres.</div>
        </div>
        <div class="mb-3">
            <label for="confirmation" class="form-label">Repetir la nueva contraseña</label>
            <input type="password" id="confirmation" name="confirmation" class="form-control" autocomplete="new-password" required />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Cambiar contraseña</button>
            <a href="@Url.Action("Profile", "Account")" class="btn btn-neutral">Cancelar</a>
        </div>
    }
</div>
