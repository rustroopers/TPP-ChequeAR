@model ChequeAR.Api.Models.QuestionnaireCompareViewModel
@using ChequeAR.Application.Services
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Comparar versiones";
    var d = Model.Diff;

    Func<string, string> label = f =>
    {
        switch (f)
        {
            case "text": return "Enunciado";
            case "section": return "Sección";
            case "type": return "Tipo";
            case "required": return "Obligatoria";
            case "repeats": return "Admite varias respuestas";
            case "maxLength": return "Largo máximo";
            case "accept": return "Formatos aceptados";
            case "unit": return "Unidad";
            case "range": return "Rango";
            case "options": return "Opciones";
            case "enableWhen": return "Mostrar sólo si";
            case "code": return "Código SNOMED CT";
            default: return f;
        }
    };
    // El tipo viaja como código de UI ("decimal"); se muestra con el mismo vocabulario
    // que el editor y la vista previa.
    Func<QuestionFieldChange, string, string> valor = (c, v) =>
        v == null ? "—" : (c.Field == "type" ? Cq.T("qtype." + v.ToLowerInvariant()) : v);
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">Comparar versiones</h1>
        <p class="cq-page-header__subtitle">@Model.Title · qué cambió de v@(Model.From) a v@(Model.To)</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("History", new { id = Model.Id })" class="btn btn-neutral"><i class="bi bi-arrow-left me-1"></i>Volver</a>
    </div>
</header>

@using (Html.BeginForm("Compare", "Questionnaires", FormMethod.Get, new { @class = "mb-3", data_cq_autofilter = "compare" }))
{
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label cq-text-sm">Desde</label>
            <select name="from" class="form-select">
                @foreach (var n in Model.Versions)
                {
                    <option value="@n" selected="@(n == Model.From)">v@(n)</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label cq-text-sm">Hasta</label>
            <select name="to" class="form-select">
                @foreach (var n in Model.Versions)
                {
                    <option value="@n" selected="@(n == Model.To)">v@(n)</option>
                }
            </select>
        </div>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="cq-card h-100">
            <div class="cq-text-sm cq-text-muted">Desde</div>
            <div class="fw-semibold">v@(Model.From)</div>
            <div class="cq-text-sm cq-text-muted">@Model.FromDate · @Model.FromAuthor</div>
            <a href="@Url.Action("Preview", new { id = Model.Id, version = Model.From })" class="cq-text-sm">Ver esta versión</a>
        </div>
    </div>
    <div class="col-md-6">
        <div class="cq-card h-100">
            <div class="cq-text-sm cq-text-muted">Hasta</div>
            <div class="fw-semibold">v@(Model.To)</div>
            <div class="cq-text-sm cq-text-muted">@Model.ToDate · @Model.ToAuthor</div>
            @if (!string.IsNullOrWhiteSpace(Model.ToChangeNote))
            {
                <div class="cq-text-sm mt-1">@Model.ToChangeNote</div>
            }
            <a href="@Url.Action("Preview", new { id = Model.Id, version = Model.To })" class="cq-text-sm">Ver esta versión</a>
        </div>
    </div>
</div>

@if (Model.From == Model.To)
{
    <div class="alert alert-info">Eligió la misma versión en los dos lados.</div>
}
else if (!d.HasChanges)
{
    <div class="cq-card">
        <div class="cq-empty">
            <div class="cq-empty__icon"><i class="bi bi-check2-circle"></i></div>
            <div class="cq-empty__title">Las dos versiones son iguales</div>
        </div>
    </div>
}
else
{
    <div class="d-flex gap-2 mb-3 cq-text-sm">
        <span class="cq-badge cq-badge--published">@d.Count(QuestionChangeKind.Added) agregada@(d.Count(QuestionChangeKind.Added) == 1 ? "" : "s")</span>
        <span class="cq-badge cq-badge--draft">@d.Count(QuestionChangeKind.Modified) modificada@(d.Count(QuestionChangeKind.Modified) == 1 ? "" : "s")</span>
        <span class="cq-badge cq-badge--archived">@d.Count(QuestionChangeKind.Removed) quitada@(d.Count(QuestionChangeKind.Removed) == 1 ? "" : "s")</span>
        <span class="cq-text-muted align-self-center">@d.Count(QuestionChangeKind.Unchanged) sin cambios</span>
    </div>

    if (d.TitleChanged)
    {
        <div class="cq-card mb-3">
            <div class="cq-text-sm cq-text-muted">Título del cuestionario</div>
            <div><del class="text-danger">@(d.TitleBefore ?? "—")</del> <i class="bi bi-arrow-right mx-1"></i> <ins class="text-success text-decoration-none">@(d.TitleAfter ?? "—")</ins></div>
        </div>
    }

    if (d.DescriptionChanged)
    {
        <div class="cq-card mb-3">
            <div class="cq-text-sm cq-text-muted">Descripción del cuestionario</div>
            <div><del class="text-danger">@(d.DescriptionBefore ?? "—")</del> <i class="bi bi-arrow-right mx-1"></i> <ins class="text-success text-decoration-none">@(d.DescriptionAfter ?? "—")</ins></div>
        </div>
    }

    <table class="cq-table">
        <thead>
            <tr>
                <th style="width:120px;">Cambio</th>
                <th>Pregunta</th>
                <th>Detalle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var q in d.Questions.Where(x => x.Kind != QuestionChangeKind.Unchanged))
            {
                <tr>
                    <td>
                        @if (q.Kind == QuestionChangeKind.Added) { <span class="cq-badge cq-badge--published">Agregada</span> }
                        else if (q.Kind == QuestionChangeKind.Removed) { <span class="cq-badge cq-badge--archived">Quitada</span> }
                        else { <span class="cq-badge cq-badge--draft">Modificada</span> }
                    </td>
                    <td>
                        <div class="fw-semibold">@q.Text</div>
                        <div class="cq-text-xs cq-text-muted"><code>@q.LinkId</code>@if (!string.IsNullOrEmpty(q.Section)) { <text> · @q.Section</text> }</div>
                    </td>
                    <td class="cq-text-sm">
                        @if (q.Kind == QuestionChangeKind.Modified)
                        {
                            foreach (var c in q.Changes)
                            {
                                <div>
                                    <span class="cq-text-muted">@label(c.Field):</span>
                                    <del class="text-danger">@valor(c, c.Before)</del>
                                    <i class="bi bi-arrow-right mx-1"></i>
                                    <ins class="text-success text-decoration-none">@valor(c, c.After)</ins>
                                </div>
                            }
                        }
                        else if (q.Kind == QuestionChangeKind.Added)
                        {
                            <span class="cq-text-muted">No estaba en v@(Model.From)</span>
                        }
                        else
                        {
                            <span class="cq-text-muted">Ya no está en v@(Model.To). Las respuestas cargadas con versiones anteriores se conservan.</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
