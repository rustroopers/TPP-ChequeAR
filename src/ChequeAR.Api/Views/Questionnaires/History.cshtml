@model System.Collections.Generic.List<ChequeAR.Api.Models.QuestionnaireVersionView>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Historial";
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">Historial · @ViewBag.QuestionnaireTitle</h1>
        <p class="cq-page-header__subtitle">Versiones publicadas y archivadas</p>
    </div>
</header>

<table class="cq-table">
    <thead>
        <tr>
            <th>Versión</th>
            <th>Fecha</th>
            <th>Autor</th>
            <th>Estado</th>
            <th>Notas</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td><strong>v@(v.Version)</strong></td>
                <td class="cq-text-sm">@v.Date</td>
                <td class="cq-text-sm">@v.Author</td>
                <td>
                    @if (v.Status == "published") { <span class="cq-badge cq-badge--published">Publicada</span> }
                    else { <span class="cq-badge cq-badge--archived">Archivada</span> }
                </td>
                <td class="cq-text-sm cq-text-muted">@v.ChangeNote</td>
                <td class="text-end">
                    <a href="#" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i> Ver</a>
                    <a href="#" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left-right"></i> Comparar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
