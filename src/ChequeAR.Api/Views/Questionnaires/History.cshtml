@model System.Collections.Generic.List<ChequeAR.Api.Models.QuestionnaireVersionView>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Historial";
    var primera = Model.Count == 0 ? 0 : Model.Min(x => x.Version);
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">Historial · @ViewBag.QuestionnaireTitle</h1>
        <p class="cq-page-header__subtitle">Versiones publicadas y archivadas</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Questionnaires")" class="btn btn-neutral"><i class="bi bi-arrow-left me-1"></i>Volver</a>
    </div>
</header>

<table class="cq-table">
    <thead>
        <tr>
            <th>Versión</th>
            <th>Fecha</th>
            <th>Autor</th>
            <th>Estado</th>
            <th>Notas</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td><strong>v@(v.Version)</strong></td>
                <td class="cq-text-sm">@v.Date</td>
                <td class="cq-text-sm">@v.Author</td>
                <td>
                    @if (v.Status == "published") { <span class="cq-badge cq-badge--published">Publicada</span> }
                    else { <span class="cq-badge cq-badge--archived">Archivada</span> }
                </td>
                <td class="cq-text-sm cq-text-muted">@v.ChangeNote</td>
                <td class="text-end">
                    @* "Ver" abre esa versión tal como se congeló al publicarla, no la actual. *@
                    <a href="@Url.Action("Preview", "Questionnaires", new { id = ViewBag.QuestionnaireId, version = v.Version })" class="btn-neutral btn-sm"><i class="bi bi-eye"></i> Ver</a>
                    @* "Comparar" contra la versión anterior. La primera no tiene con qué. *@
                    @if (v.Version > primera)
                    {
                        <a href="@Url.Action("Compare", "Questionnaires", new { id = ViewBag.QuestionnaireId, to = v.Version })" class="btn-neutral btn-sm"><i class="bi bi-arrow-left-right"></i> Comparar</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
