@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Editor de cuestionario";
    var id = ViewBag.QuestionnaireId;
    var title = ViewBag.QuestionnaireTitle as string;
    var version = ViewBag.Version;
    var isNew = (ViewBag.IsNew is bool) && (bool)ViewBag.IsNew;
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">@title</h1>
        <p class="cq-page-header__subtitle">Versión @version · borrador</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Preview", new { id = id })" class="btn btn-outline-secondary"><i class="bi bi-eye me-1"></i> Vista previa</a>
        <button type="button" class="btn btn-primary" id="saveBtn"><i class="bi bi-check2 me-1"></i> Guardar</button>
    </div>
</header>

<div id="qEditor" data-vue-island="questionnaire-editor"
     data-props='@Html.Raw("{\"id\":\"" + id + "\",\"title\":" + Newtonsoft.Json.JsonConvert.SerializeObject(title) + ",\"version\":" + version + ",\"isNew\":" + (isNew ? "true" : "false") + "}")'>
    <div class="cq-card">
        <div class="cq-loading">
            <div class="cq-spinner cq-spinner--lg"></div>
            <div class="cq-loading__label">@Cq.T("q2.loading")</div>
        </div>
    </div>
</div>

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/vue@3.4.31/dist/vue.global.prod.js"></script>
<script src="~/Scripts/islands/bootstrap.js"></script>
<script src="~/Scripts/islands/questionnaire-editor/index.js"></script>
}
