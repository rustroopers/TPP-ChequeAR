@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Editor de cuestionario";
    var id = ViewBag.QuestionnaireId;
    var title = ViewBag.QuestionnaireTitle as string;
    string props = ViewBag.EditorProps as string;
    string status = ViewBag.Status as string;
    bool pending = (ViewBag.HasUnpublishedChanges is bool) && (bool)ViewBag.HasUnpublishedChanges;
    int publishedVersion = ViewBag.Version == null ? 0 : (int)ViewBag.Version;
    int nextVersion = ViewBag.NextVersion == null ? 1 : (int)ViewBag.NextVersion;

    // El subtítulo tiene que responder dos cosas: qué versión están usando los clínicos
    // ahora, y qué pasa si publico. Antes mostraba Versions.Count + 1, una versión que
    // todavía no existía, etiquetada con el estado actual.
    string subtitle;
    if (status == "archived")
    {
        // Chequear archivado ANTES que publishedVersion == 0: un cuestionario se puede
        // archivar sin haber sido publicado nunca (baja directa de un borrador), y en ese
        // caso caía en la rama de abajo y se mostraba como "Borrador" en vez de archivado.
        subtitle = publishedVersion == 0
            ? "Archivado · nunca publicado"
            : "Archivado · última versión publicada v" + publishedVersion;
    }
    else if (publishedVersion == 0)
    {
        subtitle = "Borrador · nunca publicado · al publicar será v" + nextVersion;
    }
    else if (pending)
    {
        subtitle = "Publicado v" + publishedVersion + " · cambios sin publicar · al publicar será v" + nextVersion;
    }
    else
    {
        subtitle = "Publicado v" + publishedVersion + " · sin cambios pendientes";
    }
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">@title</h1>
        <p class="cq-page-header__subtitle">@subtitle</p>
    </div>
    <div class="d-flex gap-2">
        @if (status != "archived")
        {
            <button type="button" class="btn btn-outline-primary" id="saveBtn"><i class="bi bi-check2 me-1"></i> Guardar</button>
            @* Publicar sin salir del editor: irse de la página era justo lo que hacía
               perder los cambios sin guardar. El botón guarda y después publica. *@
            <button type="button" class="btn btn-primary" id="publishBtn">
                <i class="bi bi-send me-1"></i> @(status == "published" ? "Publicar cambios" : "Publicar")
            </button>
        }
    </div>
</header>

@* data-props sin Html.Raw: Razor escapa las comillas del JSON y getAttribute las
   des-escapa, así un título con comillas no rompe el atributo. *@
<div id="qEditor" data-vue-island="questionnaire-editor" data-props="@props">
    <div class="cq-card">
        <div class="cq-loading">
            <div class="cq-spinner cq-spinner--lg"></div>
            <div class="cq-loading__label">@Cq.T("q2.loading")</div>
        </div>
    </div>
</div>

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/vue@3.4.31/dist/vue.global.prod.js"></script>
<script src="~/Scripts/islands/bootstrap.js"></script>
<script src="~/Scripts/islands/questionnaire-editor/index.js"></script>
}
