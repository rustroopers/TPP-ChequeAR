@model ChequeAR.Api.Models.UserDetailViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Model.FullName;
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">@Model.FullName</h1>
        <p class="cq-page-header__subtitle"><code>@Model.Username</code></p>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-neutral"><i class="bi bi-arrow-left me-1"></i>Volver</a>
</header>

@using (Html.BeginForm("Save", "Users", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Username)

    <div class="cq-card mb-3" style="max-width:720px;">
        <h2>Datos</h2>
        <dl class="row">
            <dt class="col-sm-3 cq-text-sm cq-text-muted">Email</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Email) ? "—" : Model.Email)</dd>
        </dl>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="active" name="Active" @(Model.Active ? "checked" : "") />
            <label class="form-check-label" for="active">Cuenta activa</label>
        </div>
    </div>

    <div class="cq-card mb-3" style="max-width:720px;">
        <h2>Rol</h2>
        <p class="cq-text-sm cq-text-muted">
            El rol determina qué puede hacer en todo el sistema. El alcance por especialidad se
            configura aparte, abajo.
        </p>
        <select class="form-select" name="Role" style="max-width:280px;">
            @foreach (var r in ChequeAR.Domain.Enums.Role.All)
            {
                <option value="@r" selected="@(Model.Role == r)">@(r == ChequeAR.Domain.Enums.Role.Medico ? "Médico" : r)</option>
            }
        </select>
    </div>

    <div class="cq-card mb-3" style="max-width:720px;">
        <h2>Especialidades</h2>
        <p class="cq-text-sm cq-text-muted">
            Limita lo que ve y puede modificar (fichas, cuestionarios, reportes) a las especialidades
            marcadas. Un Administrador ve todas sin necesidad de que se le asignen.
        </p>
        @{
            var disponibles = ViewBag.AvailableSpecialties as IEnumerable<ChequeAR.Domain.Entities.Specialty> ?? Enumerable.Empty<ChequeAR.Domain.Entities.Specialty>();
            var asignadas = new HashSet<string>(Model.Specialties.Select(s => s.SpecialtyCode));
        }
        <div class="d-flex flex-wrap gap-3">
            @foreach (var sp in disponibles)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="SpecialtyCodes" value="@sp.Code" id="sp-@sp.Code" @(asignadas.Contains(sp.Code) ? "checked" : "") />
                    <label class="form-check-label" for="sp-@sp.Code">@sp.Name</label>
                </div>
            }
        </div>
    </div>

    <div class="d-flex gap-2" style="max-width:720px;">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </div>
}
