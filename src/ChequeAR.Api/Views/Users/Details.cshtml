@model ChequeAR.Api.Models.UserDetailViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Model.FullName;
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">@Model.FullName <span class="cq-text-sm cq-text-muted">(@Model.Username)</span></h1>
    </div>
</header>

@using (Html.BeginForm("Save", "Users", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Username)

    <div class="cq-card mb-3" style="max-width:720px;">
        <h2>Datos</h2>
        <dl class="row">
            <dt class="col-sm-3 cq-text-sm cq-text-muted">Email</dt><dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3 cq-text-sm cq-text-muted">DNI</dt><dd class="col-sm-9">@Model.DNI</dd>
        </dl>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="active" name="Active" @(Model.Active ? "checked" : "") />
            <label class="form-check-label" for="active">Cuenta activa</label>
        </div>
    </div>

    <div class="cq-card mb-3" style="max-width:720px;">
        <h2>Rol</h2>
        <p class="cq-text-sm cq-text-muted">
            El rol determina qué puede hacer en todo el sistema. El alcance por especialidad se
            configura aparte, abajo.
        </p>
        <select class="form-select" name="Role" style="max-width:280px;">
            @foreach (var r in ChequeAR.Domain.Enums.Role.All)
            {
                <option value="@r" selected="@(Model.Role == r)">@r</option>
            }
        </select>
    </div>

    <div class="cq-card mb-3" style="max-width:720px;">
        <h2>Especialidades</h2>
        <p class="cq-text-sm cq-text-muted">
            Acota lo que ve y puede tocar (fichas, cuestionarios, reportes) a estas especialidades.
            Un Administrador ve todas sin necesidad de que se le asignen.
        </p>
        @for (int i = 0; i < Model.Specialties.Count; i++)
        {
            var sp = Model.Specialties[i];
            <div class="row g-2 align-items-center mb-2">
                <div class="col-md-5"><span class="cq-chip cq-chip--zone-@sp.SpecialtyColor">@sp.SpecialtyLabel</span></div>
                <input type="hidden" name="Specialties[@i].SpecialtyCode" value="@sp.SpecialtyCode" />
                <input type="hidden" name="Specialties[@i].SpecialtyLabel" value="@sp.SpecialtyLabel" />
            </div>
        }
        @if (Model.Specialties.Count == 0)
        {
            <p class="cq-text-sm cq-text-muted fst-italic">Sin especialidades asignadas.</p>
        }
    </div>

    <div class="d-flex gap-2">
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </div>
}
