@model ChequeAR.Api.Models.UserListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Cq.T("users.title");
    var pageSize = Model.PageSize > 0 ? Model.PageSize : 50;
    var totalPages = (int)Math.Ceiling((double)Model.Total / pageSize);
    var startIdx = (Model.Page - 1) * pageSize + 1;
    var endIdx = (Model.Page - 1) * pageSize + Model.Users.Count;
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">@Cq.T("users.title")</h1>
    </div>
</header>

@using (Html.BeginForm("Index", "Users", FormMethod.Get, new { @class = "mb-3" }))
{
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label cq-text-sm" for="users-q">Buscar</label>
            <input type="search" class="form-control" id="users-q" name="q" value="@Model.Query" placeholder="Usuario, nombre o correo" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-neutral"><i class="bi bi-search me-1"></i>Buscar</button>
        </div>
    </div>
}

@if (Model.Users == null || Model.Users.Count == 0)
{
    <div class="cq-card cq-card--stretch">
        <div class="cq-empty">
            <div class="cq-empty__icon"><i class="bi bi-people"></i></div>
            <div class="cq-empty__title">@(string.IsNullOrEmpty(Model.Query) ? "No hay usuarios en el sistema" : "Ningún usuario coincide con la búsqueda")</div>
        </div>
    </div>
}
else
{
    <table class="cq-table">
        <thead>
            <tr><th>Usuario</th><th>Nombre</th><th>Rol</th><th>Especialidad</th><th>Estado</th><th class="text-end"></th></tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Users)
            {
                <tr>
                    <td><code>@u.Username</code></td>
                    <td>@u.FullName</td>
                    <td>@(u.Role == ChequeAR.Domain.Enums.Role.Medico ? "Médico" : u.Role)</td>
                    <td class="cq-text-sm">@u.Specialty</td>
                    <td>
                        @if (u.Active) { <span class="cq-badge cq-badge--published">Activo</span> }
                        else { <span class="cq-badge cq-badge--archived">Inactivo</span> }
                    </td>
                    <td class="text-end"><a href="@Url.Action("Details", new { username = u.Username })" class="btn btn-sm btn-tertiary">Editar →</a></td>
                </tr>
            }
        </tbody>
    </table>
    <div class="d-flex justify-content-between align-items-center mt-3 cq-text-sm cq-text-muted">
        <span>@startIdx-@endIdx de @Model.Total.ToString("N0")</span>
        @if (totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Url.Action("Index", new { q = Model.Query, page = Model.Page - 1 })">‹</a></li>
                    <li class="page-item active"><span class="page-link">@Model.Page / @totalPages</span></li>
                    <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")"><a class="page-link" href="@Url.Action("Index", new { q = Model.Query, page = Model.Page + 1 })">›</a></li>
                </ul>
            </nav>
        }
    </div>
}
