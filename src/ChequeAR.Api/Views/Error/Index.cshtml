@{
    Layout = null;
    var code = ViewBag.Code as int? ?? 404;
    string title, desc, icon;
    switch (code)
    {
        case 401: title = "La sesión expiró"; desc = "Volver a iniciar sesión."; icon = "bi-shield-lock"; break;
        case 403: title = "No tiene permisos"; desc = "Su rol no habilita esta sección."; icon = "bi-slash-circle"; break;
        case 500: title = "Algo salió mal"; desc = "Hubo un problema procesando su pedido. Reintente en unos segundos."; icon = "bi-bug"; break;
        default:  title = "Página no encontrada"; desc = "La sección que busca no existe o se movió."; icon = "bi-compass"; break;
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error @code · ChequeAR</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" integrity="sha384-tViUnnbYAV00FLIhhi3v/dWt3Jxw4gZQcNoSCxCIFNJVCx7/D55/wXsrNIRANwdD" crossorigin="anonymous" />
    <link href="@Asset.Url("~/Content/theme/chequear-theme.css")" rel="stylesheet" />
</head>
<body>
    <div class="cq-centered">
        <div class="cq-centered__card">
            <i class="@icon" style="font-size:56px; color: var(--cq-primary-400);"></i>
            <h1 class="mt-3 mb-2">@code · @title</h1>
            <p class="cq-text-muted mb-4">@desc</p>
            <div class="d-flex gap-2 justify-content-center">
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Volver al inicio</a>
                <a href="javascript:history.back()" class="btn btn-outline-secondary">Atrás</a>
            </div>
        </div>
    </div>
</body>
</html>
