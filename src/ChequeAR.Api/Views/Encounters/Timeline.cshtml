@model ChequeAR.Api.Models.PatientTimelineViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Historial";
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">Historial</h1>
        <p class="cq-page-header__subtitle">
            @Model.Patient.FullName@if (!string.IsNullOrEmpty(Model.Patient.AgeLabel)) { <text> (@Model.Patient.AgeLabel)</text> }
        </p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Encounters")" class="btn btn-neutral"><i class="bi bi-arrow-left me-1"></i>Volver a pacientes</a>
        <a href="@Url.Action("Trend", new { patientId = Model.Patient.HC })" class="btn btn-secondary"><i class="bi bi-graph-up me-1"></i>Ver evolución</a>
    </div>
</header>

@using (Html.BeginForm("Timeline", "Encounters", FormMethod.Get, new { @class = "mb-3", data_cq_autofilter = "patient-timeline" }))
{
    @Html.Hidden("patientId", Model.Patient.HC)
    @* Feedback: Período estaba en un segundo renglón. Se pasan todos los filtros a la misma
       fila reduciendo el ancho de cada select (col-md-2). *@
    <div class="row g-2 align-items-end">
        <div class="col-md-2 col-lg-2">
            <label class="form-label cq-text-sm">Cuestionario</label>
            <select class="form-select" name="cuestionario">
                <option value="">Todos</option>
                @foreach (var opt in Model.AvailableQuestionnaires)
                {
                    <option value="@opt.Value" selected="@(Model.QuestionnaireFilter.HasValue && Model.QuestionnaireFilter.Value.ToString() == opt.Value)">@opt.Label</option>
                }
            </select>
        </div>
        <div class="col-md-2 col-lg-2">
            <label class="form-label cq-text-sm">Especialidad</label>
            <select class="form-select" name="especialidad">
                <option value="">Todas</option>
                @foreach (var opt in Model.AvailableSpecialties)
                {
                    <option value="@opt.Value" selected="@(Model.SpecialtyFilter == opt.Value)">@opt.Label</option>
                }
            </select>
        </div>
        <div class="col-md-2 col-lg-2">
            <label class="form-label cq-text-sm">Autor</label>
            <select class="form-select" name="autor">
                <option value="">Todos</option>
                @foreach (var a in Model.AvailableAuthors)
                {
                    <option value="@a" selected="@(Model.AuthorFilter == a)">@a</option>
                }
            </select>
        </div>
        <div class="col-md-2 col-lg-2">
            <label class="form-label cq-text-sm">Estado</label>
            <select class="form-select" name="estado">
                <option value="">Todos</option>
                <option value="pendiente" selected="@(Model.StatusFilter == "pendiente")">Pendiente</option>
                <option value="finalizada" selected="@(Model.StatusFilter == "finalizada")">Finalizada</option>
            </select>
        </div>
        <div class="col-md-4 col-lg-4">
            <label class="form-label cq-text-sm">Período</label>
            <cq-date-range name-from="from" name-to="to" value-from="@Model.From" value-to="@Model.To"></cq-date-range>
        </div>
    </div>
}

<div class="cq-card cq-card--stretch">
    @if (Model.Entries.Count == 0)
    {
        <div class="cq-empty">
            <div class="cq-empty__icon"><i class="bi bi-clock-history"></i></div>
            @if (Model.HasAnyEncounters)
            {
                <div class="cq-empty__title">Sin resultados para estos filtros</div>
            }
            else
            {
                <div class="cq-empty__title">Sin fichas previas</div>
            }
        </div>
    }
    else
    {
        <div style="position:relative; padding-left:20px;">
            @for (var i = 0; i < Model.Entries.Count; i++)
            {
                var e = Model.Entries[i];
                var isLast = i == Model.Entries.Count - 1;
                <div class="cq-timeline-entry" style="position:relative; padding-bottom:24px;">
                    @if (!isLast)
                    {
                        <span style="position:absolute; left:-22px; top:18px; bottom:-12px; width:2px; background:var(--cq-neutral-200);"></span>
                    }
                    <span style="position:absolute; left:-27px; top:14px; width:12px; height:12px; border-radius:50%; background:var(--cq-primary); border:2px solid #fff;"></span>
                    <div class="d-flex align-items-center gap-3">
                        @* Columna 1: fecha + autor (ancho fijo, ancla visual del thread) *@
                        <div style="min-width:150px;">
                            <div class="cq-text-sm cq-text-muted">@e.Date</div>
                            <div class="cq-text-xs cq-text-muted">por @e.Author</div>
                        </div>
                        @* Columna 2: título + versión + chips (crece para llenar el espacio) *@
                        <div class="flex-fill d-flex align-items-center flex-wrap gap-2">
                            <strong>@e.QuestionnaireTitle</strong>
                            @if (e.QuestionnaireVersion > 0)
                            {
                                <span class="cq-text-xs cq-text-muted" title="Versión con la que se completó">v@(e.QuestionnaireVersion)</span>
                            }
                            <span class="cq-chip cq-chip--zone-@e.SpecialtyColor">@e.SpecialtyLabel</span>
                            @if (e.Status == "completed")
                            {
                                <span class="cq-badge cq-badge--published">Finalizada</span>
                            }
                            else if (e.Status == "amended")
                            {
                                <span class="cq-badge cq-badge--published">Corregida</span>
                            }
                            else if (e.Status == "enteredinerror")
                            {
                                <span class="cq-badge cq-badge--archived" title="Respuesta incompleta descartada">Descartada</span>
                            }
                            else
                            {
                                <span class="cq-badge cq-badge--info">Pendiente</span>
                            }
                        </div>
                        @* Columna 3: acción alineada a la derecha *@
                        @* Una descartada no se retoma: se abre en lectura, igual que una finalizada. *@
                        @if (e.Status == "completed" || e.Status == "amended" || e.Status == "enteredinerror")
                        {
                            <a href="@Url.Action("View", new { id = e.EncounterId })" class="btn btn-sm btn-tertiary">Abrir →</a>
                        }
                        else
                        {
                            <a href="@Url.Action("Load", new { patientId = Model.Patient.HC, questionnaireId = e.QuestionnaireId })" class="btn btn-sm btn-primary"><i class="bi bi-pencil-square me-1"></i>Continuar edición</a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
