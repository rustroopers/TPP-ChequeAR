@model ChequeAR.Api.Models.EncounterHistoryViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Detalle de la ficha";
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title"><i class="bi bi-clock-history me-1"></i> Detalle de la ficha</h1>
        <p class="cq-page-header__subtitle">
            @(Model.Patient != null ? Model.Patient.FullName : null)
            @if (!string.IsNullOrEmpty(Model.QuestionnaireTitle))
            {
                <span class="cq-text-sm cq-text-muted">· @Model.QuestionnaireTitle</span>
                if (Model.QuestionnaireVersion > 0)
                {
                    <span class="cq-text-sm cq-text-muted" title="Versión con la que se completó esta ficha">v@(Model.QuestionnaireVersion)</span>
                }
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status == "completed" || Model.Status == "amended")
        {
            <a href="@Url.Action("View", new { id = Model.EncounterId })" class="btn btn-outline-secondary"><i class="bi bi-file-text me-1"></i> Ver ficha</a>
        }
        @if (Model.Patient != null && !string.IsNullOrEmpty(Model.Patient.HC) && Model.QuestionnaireId != Guid.Empty)
        {
            if (Model.Status == "inprogress")
            {
                <a href="@Url.Action("Load", new { patientId = Model.Patient.HC, questionnaireId = Model.QuestionnaireId })" class="btn btn-primary"><i class="bi bi-pencil-square me-1"></i> Continuar edición</a>
            }
            else
            {
                @* Ficha ya finalizada: "volver a completar" arranca una ficha nueva del mismo
                   cuestionario para este paciente (no reabre la finalizada). *@
                <a href="@Url.Action("Load", new { patientId = Model.Patient.HC, questionnaireId = Model.QuestionnaireId })" class="btn btn-primary"><i class="bi bi-pencil-square me-1"></i> Volver a completar</a>
            }
        }
        @if (Model.Patient != null && !string.IsNullOrEmpty(Model.Patient.HC))
        {
            <a href="@Url.Action("Timeline", new { patientId = Model.Patient.HC })" class="btn btn-outline-secondary">Ver historial</a>
        }
    </div>
</header>

<div class="cq-card" style="max-width:760px;">
    @if (Model.Entries.Count == 0)
    {
        <div class="cq-empty">
            <div class="cq-empty__icon"><i class="bi bi-clock-history"></i></div>
            <div class="cq-empty__title">Sin movimientos registrados</div>
            <div class="cq-empty__desc">Todavía no hay eventos de auditoría para esta ficha.</div>
        </div>
    }
    else
    {
        <div style="position:relative; padding-left:20px;">
            @for (var i = 0; i < Model.Entries.Count; i++)
            {
                var e = Model.Entries[i];
                var isLast = i == Model.Entries.Count - 1;
                <div style="position:relative; padding-bottom:24px;">
                    @if (!isLast)
                    {
                        <span style="position:absolute; left:-22px; top:18px; bottom:-12px; width:2px; background:var(--cq-neutral-200);"></span>
                    }
                    <span style="position:absolute; left:-27px; top:6px; width:12px; height:12px; border-radius:50%; background:var(--cq-primary); border:2px solid #fff;"></span>
                    <div class="cq-text-sm cq-text-muted">@e.Timestamp</div>
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <span class="cq-badge @e.BadgeClass"><i class="bi @e.Icon me-1"></i>@e.Label</span>
                        <span class="cq-text-sm">por <strong>@e.Username</strong></span>
                    </div>
                    @if (!string.IsNullOrEmpty(e.Note))
                    {
                        <div class="cq-text-sm mt-1">@e.Note</div>
                    }
                    @if (e.Changes != null && e.Changes.Count > 0)
                    {
                        <table class="table cq-table mt-2 mb-0">
                            <thead>
                                <tr><th>Pregunta</th><th>Antes</th><th>Después</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var c in e.Changes)
                                {
                                    <tr>
                                        <td>@c.Text</td>
                                        <td><span class="cq-diff__del">@c.Before</span></td>
                                        <td><span class="cq-diff__add">@c.After</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            }
        </div>
    }
</div>
