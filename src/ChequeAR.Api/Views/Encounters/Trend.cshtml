@model ChequeAR.Api.Models.PatientTrendViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Evolución de parámetros";
    var selected = Model.SelectedQuestionnaireId == null ? null : Model.SelectedQuestionnaireId.ToString();
    var islandProps = Newtonsoft.Json.JsonConvert.SerializeObject(new
    {
        patientId = Model.Patient == null ? null : Model.Patient.HC,
        questionnaireId = selected
    });
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">Evolución de parámetros</h1>
        <p class="cq-page-header__subtitle">
            @if (Model.Patient != null && !string.IsNullOrEmpty(Model.Patient.FullName))
            {
                <text>@Model.Patient.FullName@(string.IsNullOrEmpty(Model.Patient.AgeLabel) ? "" : " (" + Model.Patient.AgeLabel + ")") · </text>
            }
            Valores a lo largo de sus fichas finalizadas
        </p>
    </div>
    @if (Model.Patient != null)
    {
        <a href="@Url.Action("Timeline", new { patientId = Model.Patient.HC })" class="btn btn-neutral"><i class="bi bi-arrow-left me-1"></i>Volver al historial</a>
    }
</header>

@* El aviso de error lo muestra el layout (_DataError). *@
@if (!string.IsNullOrEmpty(ViewBag.DataError as string))
{
}
else if (!Model.HasAnyCompleted)
{
    <div class="cq-card">
        <div class="cq-empty">
            <div class="cq-empty__icon"><i class="bi bi-graph-up"></i></div>
            <div class="cq-empty__title">Sin fichas finalizadas</div>
        </div>
    </div>
}
else
{
    using (Html.BeginForm("Trend", "Encounters", FormMethod.Get, new { @class = "mb-3", data_cq_autofilter = "patient-trend" }))
    {
        @Html.Hidden("patientId", Model.Patient.HC)
        <div class="row g-2 align-items-end" style="max-width:520px;">
            <div class="col-md-8">
                <label class="form-label cq-text-sm">Cuestionario</label>
                <select class="form-select" name="questionnaireId">
                    <option value="">Seleccione un cuestionario…</option>
                    @foreach (var opt in Model.AvailableQuestionnaires)
                    {
                        <option value="@opt.Value" selected="@(selected == opt.Value)">@opt.Label</option>
                    }
                </select>
            </div>
        </div>
    }

    if (Model.SelectedQuestionnaireId == null)
    {
        <div class="cq-card cq-text-sm cq-text-muted">
            Seleccione un cuestionario para ver qué parámetros se pueden graficar.
        </div>
    }
    else
    {
        <div data-vue-island="patient-trend" data-props="@islandProps">
            <div class="cq-card">
                <div class="cq-loading">
                    <div class="cq-spinner cq-spinner--lg"></div>
                    <div class="cq-loading__label">Cargando parámetros…</div>
                </div>
            </div>
        </div>
    }
}

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/vue@3.4.31/dist/vue.global.prod.js" integrity="sha384-V51X2t6rrCZupAhpkTcJvJMv6DQhFAxxMsb3vBXigj/RoxwsbZbQqwWg5aMX0XHQ" crossorigin="anonymous"></script>
<script src="@Asset.Url("~/Scripts/islands/bootstrap.js")"></script>
<script src="@Asset.Url("~/Scripts/islands/patient-trend/index.js")"></script>
}
