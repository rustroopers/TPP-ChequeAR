@model ChequeAR.Api.Models.EncounterReadonlyViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Ficha #" + Model.EncounterId;
}

<header class="cq-page-header">
    <div>
        <span class="cq-badge cq-badge--archived"><i class="bi bi-lock me-1"></i> Solo lectura</span>
        @if (Model.IsDiscarded)
        {
            <span class="cq-badge cq-badge--archived" title="Respuesta incompleta descartada">Descartada</span>
        }
        @if (Model.IsAmended)
        {
            <span class="cq-badge cq-badge--info">Corregida</span>
        }
        @* Version 0 = ficha anterior al anclaje de version: no se sabe con cuál se cargó,
           y decir "v0" sería inventar un dato. *@
        <h1 class="cq-page-header__title mt-2">
            @Model.Patient.FullName
            @if (Model.QuestionnaireVersion > 0)
            {
                <span class="cq-text-sm cq-text-muted" title="Versión con la que se completó esta ficha">v@(Model.QuestionnaireVersion)</span>
            }
            else
            {
                <span class="cq-text-sm cq-text-muted" title="Ficha anterior al registro de versión">versión no registrada</span>
            }
        </h1>
        <p class="cq-page-header__subtitle">
            @(Model.IsDiscarded ? "Respuesta incompleta descartada" : "Registro completo de la ficha finalizada") · cargada por @Model.Author · @Model.FinalizedAt
        </p>
    </div>
    <div class="d-flex gap-2">
        @if (!Model.IsDiscarded && Model.Groups.Count > 0 && Cq.Can(ChequeAR.Domain.Enums.Permissions.EncounterWrite))
        {
            <a href="@Url.Action("Amend", new { id = Model.EncounterId })" class="btn btn-neutral"><i class="bi bi-pencil me-1"></i>Corregir</a>
        }
        <a href="@Url.Action("History", new { id = Model.EncounterId })" class="btn btn-primary" title="Quién y cuándo completó cada cambio"><i class="bi bi-clock-history me-1"></i> Detalle</a>
        <a href="@Url.Action("Timeline", new { patientId = Model.Patient.HC })" class="btn btn-neutral"><i class="bi bi-arrow-left me-1"></i>Volver al historial</a>
    </div>
</header>

<div class="cq-card cq-card--stretch">
    @foreach (var g in Model.Groups)
    {
        <h2 class="cq-section-title" style="margin-top:0;">@g.Title</h2>
        <dl class="row mb-0">
            @foreach (var q in g.Questions)
            {
                <dt class="col-sm-5">@q.Text</dt>
                <dd class="col-sm-7">
                    <strong>@q.Answer</strong>
                    @if (!string.IsNullOrEmpty(q.Unit)) { <span class="cq-text-sm cq-text-muted ms-1">@q.Unit</span> }
                    @if (q.AttachmentId.HasValue)
                    {
                        <button type="button" class="btn btn-sm btn-link cq-view-attachment" data-attachment-id="@q.AttachmentId">Ver</button>
                    }
                </dd>
            }
        </dl>
        <hr />
    }
</div>

<script>
    // El endpoint pide JWT por Authorization header; un <a href> normal no lo manda, así
    // que se trae el archivo por fetch (mismo patrón que Search.cshtml) y se abre como blob.
    document.addEventListener('click', function (ev) {
        var btn = ev.target.closest && ev.target.closest('.cq-view-attachment');
        if (!btn) return;
        var id = btn.getAttribute('data-attachment-id');
        var original = btn.textContent;
        btn.disabled = true; btn.textContent = 'Abriendo…';
        fetch('/api/attachments/' + id)
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.blob(); })
            .then(function (blob) {
                var url = URL.createObjectURL(blob);
                window.open(url, '_blank');
                setTimeout(function () { URL.revokeObjectURL(url); }, 60000);
            })
            .catch(function () { window.cqToast && window.cqToast('No se pudo abrir el adjunto.', 'error'); })
            .then(function () { btn.disabled = false; btn.textContent = original; });
    });
</script>
