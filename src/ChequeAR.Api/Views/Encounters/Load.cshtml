@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Carga de ficha";
    string rendererProps = ViewBag.RendererProps as string;
    string loadError = ViewBag.LoadError as string;
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">@ViewBag.QuestionnaireTitle <span class="cq-text-sm cq-text-muted">v@(ViewBag.Version)</span></h1>
        <p class="cq-page-header__subtitle">@ViewBag.PatientName</p>
    </div>
    @* La ficha puede completarse de forma asincrónica (ej. seguimiento telefónico
       semana a semana): el renderer resume una ficha InProgress existente, toma un
       lock de sesión y autoguarda con PUT + $lock/$renew-lock/$unlock. *@
    @* "Detalle": historial de quién/cuándo tocó esta ficha. Sólo si ya existe la ficha
       (un borrado previo); una carga nueva todavía no generó eventos que mostrar. *@
    @if (ViewBag.ExistingResponseId != null)
    {
        <a href="@Url.Action("History", new { id = (Guid)ViewBag.ExistingResponseId })" class="btn btn-outline-secondary" title="Quién y cuándo completó cada cambio"><i class="bi bi-clock-history me-1"></i> Detalle</a>
    }
</header>

@if (!string.IsNullOrEmpty(loadError))
{
    <div class="cq-card">
        <div class="cq-empty">
            <div class="cq-empty__icon"><i class="bi bi-exclamation-triangle"></i></div>
            <div class="cq-empty__title">No se puede cargar la ficha</div>
            <div class="cq-empty__desc">@loadError</div>
            <a href="@Url.Action("Search")" class="btn btn-outline-secondary">Volver a Pacientes</a>
        </div>
    </div>
}
else
{
    @* La ficha viene de la versión congelada, servida por el controller. Si alguien publica
       un cambio mientras se completa, esto no se mueve; el renderer ofrece pasar a la versión
       nueva (con preview del merge) cuando corresponde. *@
    <div id="qRenderer" data-vue-island="questionnaire-renderer" data-props="@rendererProps">
        <div class="cq-card">
            <div class="cq-loading">
                <div class="cq-spinner cq-spinner--lg"></div>
                <div class="cq-loading__label">@Cq.T("r3.loading")</div>
            </div>
        </div>
    </div>
}

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/vue@3.4.31/dist/vue.global.prod.js"></script>
<script src="~/Scripts/islands/bootstrap.js"></script>
<script src="~/Scripts/islands/questionnaire-renderer/index.js"></script>
}
