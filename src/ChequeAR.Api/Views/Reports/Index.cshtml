@model ChequeAR.Api.Models.ReportListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Reportes";
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">Reportes</h1>
        <p class="cq-page-header__subtitle">Cohortes guardadas y nuevas consultas</p>
    </div>
    <a href="@Url.Action("Build")" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Nueva consulta</a>
</header>

@if (Model.Items.Count == 0)
{
    <div class="cq-card">
        <div class="cq-empty">
            <div class="cq-empty__icon"><i class="bi bi-bar-chart"></i></div>
            <div class="cq-empty__title">Sin reportes guardados</div>
            <div class="cq-empty__desc">Armá tu primera consulta para empezar.</div>
            <a href="@Url.Action("Build")" class="btn btn-primary">Nueva consulta</a>
        </div>
    </div>
}
else
{
    <table class="cq-table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Cuestionario base</th>
                <th>Autor</th>
                <th>Último uso</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Items)
            {
                <tr>
                    <td><a href="@Url.Action("Build", new { id = r.Id })" class="text-decoration-none">@r.Name</a></td>
                    <td class="cq-text-sm">@r.QuestionnaireTitle</td>
                    <td class="cq-text-sm">@r.Author</td>
                    <td class="cq-text-sm cq-text-muted">@r.LastUsedAt</td>
                    <td class="text-end">
                        <a href="@Url.Action("Preview", new { id = r.Id })" class="btn btn-sm btn-outline-secondary"><i class="bi bi-table me-1"></i> Preview</a>
                        <a href="@Url.Action("Stats", new { id = r.Id })" class="btn btn-sm btn-outline-secondary"><i class="bi bi-graph-up me-1"></i> Stats</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
