@model ChequeAR.Api.Models.ReportListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Cq.T("e1.title");
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">@Cq.T("e1.title")</h1>
        <p class="cq-page-header__subtitle">@Cq.T("e1.subtitle")</p>
    </div>
    <a href="@Url.Action("Build")" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> @Cq.T("e1.new")</a>
</header>

@if (Model.Items.Count == 0)
{
    <div class="cq-card">
        <div class="cq-empty">
            <div class="cq-empty__icon"><i class="bi bi-bar-chart"></i></div>
            <div class="cq-empty__title">@Cq.T("e1.empty.title")</div>
            <div class="cq-empty__desc">@Cq.T("e1.empty.desc")</div>
            <a href="@Url.Action("Build")" class="btn btn-primary">@Cq.T("e1.new")</a>
        </div>
    </div>
}
else
{
    <table class="cq-table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Cuestionario base</th>
                <th>Autor</th>
                <th>Último uso</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Items)
            {
                <tr>
                    <td><a href="@Url.Action("Build", new { id = r.Id })" class="text-decoration-none">@r.Name</a></td>
                    <td class="cq-text-sm">@r.QuestionnaireTitle</td>
                    <td class="cq-text-sm">@r.Author</td>
                    <td class="cq-text-sm cq-text-muted">@r.LastUsedAt</td>
                    <td class="text-end">
                        <a href="@Url.Action("Preview", new { id = r.Id })" class="btn-neutral btn-sm"><i class="bi bi-table"></i> Vista previa</a>
                        <a href="@Url.Action("Stats", new { id = r.Id })" class="btn-neutral btn-sm"><i class="bi bi-graph-up"></i> Estadísticas</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
