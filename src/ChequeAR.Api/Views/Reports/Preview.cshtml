@model ChequeAR.Api.Models.ReportPreviewViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Preview";
    var pageSize = Model.PageSize > 0 ? Model.PageSize : 50;
    var totalPages = (int)Math.Ceiling((double)Model.Total / pageSize);
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">@Model.ReportName</h1>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Build", new { id = ViewBag.ReportId })" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Volver</a>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exportModal"><i class="bi bi-download me-1"></i> Exportar</button>
    </div>
</header>

<table class="cq-table">
    <thead>
        <tr>@foreach (var c in Model.Columns) { <th>@c</th> }</tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>@foreach (var c in Model.Columns) { <td>@(row.Cells.ContainsKey(c) ? row.Cells[c] : "")</td> }</tr>
        }
    </tbody>
</table>
<div class="d-flex justify-content-between align-items-center mt-3 cq-text-sm cq-text-muted">
    <span>Mostrando @(Model.Rows.Count == 0 ? 0 : (Model.Page - 1) * pageSize + 1)-@((Model.Page - 1) * pageSize + Model.Rows.Count) de @Model.Total</span>
    @if (totalPages > 1)
    {
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Url.Action("Preview", new { id = ViewBag.ReportId, page = Model.Page - 1 })">‹</a></li>
                <li class="page-item active"><span class="page-link">@Model.Page</span></li>
                <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")"><a class="page-link" href="@Url.Action("Preview", new { id = ViewBag.ReportId, page = Model.Page + 1 })">›</a></li>
            </ul>
        </nav>
    }
</div>

@* E4 — Modal exportar *@
<div class="modal fade" id="exportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h3">Exportar</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Formato</label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" id="fmtXlsx" name="format" value="xlsx" checked />
                            <label class="form-check-label" for="fmtXlsx">Excel (.xlsx)</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" id="fmtCsv" name="format" value="csv" />
                            <label class="form-check-label" for="fmtCsv">CSV</label>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Codificación CSV</label>
                    <select class="form-select" style="max-width:240px;">
                        <option>UTF-8 con BOM</option>
                        <option>UTF-8</option>
                        <option>Latin-1</option>
                    </select>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="anon" checked />
                    <label class="form-check-label" for="anon">Anonimizar (reemplazar HC por hash)</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="meta" checked />
                    <label class="form-check-label" for="meta">Incluir metadatos (versión, fecha)</label>
                </div>
                <p class="cq-text-sm cq-text-muted mt-3 mb-0">Filas a exportar: @Model.Total</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary">Descargar</button>
            </div>
        </div>
    </div>
</div>
