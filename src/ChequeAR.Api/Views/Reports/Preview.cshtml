@model ChequeAR.Api.Models.ReportPreviewViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Vista previa";
    var pageSize = Model.PageSize > 0 ? Model.PageSize : 50;
    var totalPages = (int)Math.Ceiling((double)Model.Total / pageSize);
    // Fechas y decimales como en el resto de la app (dd/mm/aaaa, coma).
    Func<string, string> celda = v =>
    {
        if (string.IsNullOrEmpty(v)) return v;
        var d = System.Text.RegularExpressions.Regex.Match(v, @"^(\d{4})-(\d{2})-(\d{2})$");
        if (d.Success) return d.Groups[3].Value + "/" + d.Groups[2].Value + "/" + d.Groups[1].Value;
        if (System.Text.RegularExpressions.Regex.IsMatch(v, @"^-?\d+\.\d+$")) return v.Replace('.', ',');
        return v;
    };
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">@Model.ReportName</h1>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index")" class="btn btn-neutral"><i class="bi bi-arrow-left me-1"></i>Volver</a>
        @* La exportación vive en el constructor (isla report-builder), que es quien arma la consulta. *@
        <a href="@Url.Action("Build", new { id = ViewBag.ReportId })" class="btn btn-primary"><i class="bi bi-download me-1"></i> Editar y exportar</a>
    </div>
</header>

<table class="cq-table">
    <thead>
        <tr>@foreach (var c in Model.Columns) { <th>@c</th> }</tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>@foreach (var c in Model.Columns) { <td>@(row.Cells.ContainsKey(c) ? celda(row.Cells[c]) : "")</td> }</tr>
        }
    </tbody>
</table>
<div class="d-flex justify-content-between align-items-center mt-3 cq-text-sm cq-text-muted">
    <span>Mostrando @(Model.Rows.Count == 0 ? 0 : (Model.Page - 1) * pageSize + 1)-@((Model.Page - 1) * pageSize + Model.Rows.Count) de @Model.Total</span>
    @if (totalPages > 1)
    {
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Url.Action("Preview", new { id = ViewBag.ReportId, page = Model.Page - 1 })">‹</a></li>
                <li class="page-item active"><span class="page-link">@Model.Page</span></li>
                <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")"><a class="page-link" href="@Url.Action("Preview", new { id = ViewBag.ReportId, page = Model.Page + 1 })">›</a></li>
            </ul>
        </nav>
    }
</div>
