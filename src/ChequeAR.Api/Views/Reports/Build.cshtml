@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Consulta";
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">@(ViewBag.ReportId != null ? "Editar consulta" : "Nueva consulta")</h1>
        <p class="cq-page-header__subtitle">Filtrá respuestas por preguntas, fechas y especialidad</p>
    </div>
</header>

<div id="rBuilder" data-vue-island="report-builder"
     data-props='@Html.Raw("{\"reportId\":" + (ViewBag.ReportId != null ? "\"" + ViewBag.ReportId + "\"" : "null") + "}")'>
    <div class="cq-card">
        <div class="cq-loading">
            <div class="cq-spinner cq-spinner--lg"></div>
            <div class="cq-loading__label">@Cq.T("e2.loading")</div>
        </div>
    </div>
</div>

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/vue@3.4.31/dist/vue.global.prod.js"></script>
<script src="~/Scripts/islands/bootstrap.js"></script>
<script src="~/Scripts/islands/report-builder/index.js"></script>
}
