@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Reporte";
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">@(ViewBag.ReportId != null ? "Editar reporte" : "Nuevo reporte")</h1>
        <p class="cq-page-header__subtitle">Seleccione un cuestionario y filtre las fichas por sus respuestas y fechas</p>
    </div>
</header>

<div id="rBuilder" data-vue-island="report-builder"
     data-props="@(Newtonsoft.Json.JsonConvert.SerializeObject(new { reportId = ViewBag.ReportId == null ? null : (string)ViewBag.ReportId.ToString() }))">
    <div class="cq-card">
        <div class="cq-loading">
            <div class="cq-spinner cq-spinner--lg"></div>
            <div class="cq-loading__label">@Cq.T("e2.loading")</div>
        </div>
    </div>
</div>

@* Estadísticas del grupo de fichas que se acaba de armar. Isla aparte: escucha el
   evento cq:report-query que emite el constructor, así los números son siempre los de
   las condiciones que están en pantalla. *@
<div class="mt-3" data-vue-island="report-stats"></div>

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/vue@3.4.31/dist/vue.global.prod.js" integrity="sha384-V51X2t6rrCZupAhpkTcJvJMv6DQhFAxxMsb3vBXigj/RoxwsbZbQqwWg5aMX0XHQ" crossorigin="anonymous"></script>
<script src="@Asset.Url("~/Scripts/islands/bootstrap.js")"></script>
<script src="@Asset.Url("~/Scripts/islands/report-builder/index.js")"></script>
<script src="@Asset.Url("~/Scripts/islands/report-stats/index.js")"></script>
}
