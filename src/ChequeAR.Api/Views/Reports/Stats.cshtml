@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Estadísticas";
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">Estadísticas · HTA pediátrica 2026</h1>
        <p class="cq-page-header__subtitle">Gráficos sobre la cohorte filtrada</p>
    </div>
</header>

<div class="cq-grid cq-grid--3">
    <div class="cq-card"><h3>Distribución por edad</h3><canvas id="chartAge" height="180"></canvas></div>
    <div class="cq-card"><h3>HTA Sí vs No</h3><canvas id="chartHta" height="180"></canvas></div>
    <div class="cq-card" style="grid-column: span 2;"><h3>TA sistólica · histograma</h3><canvas id="chartTa" height="180"></canvas></div>
</div>

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
    var brandColor = getComputedStyle(document.documentElement).getPropertyValue('--cq-primary').trim() || '#6f5fa5';
    var accentColor = getComputedStyle(document.documentElement).getPropertyValue('--cq-accent').trim() || '#73C4A4';

    new Chart(document.getElementById('chartAge'), {
        type: 'bar',
        data: {
            labels: ['0-2','3-5','6-8','9-11','12-14','15-17'],
            datasets: [{ label: 'Pacientes', data: [12, 23, 41, 34, 22, 10], backgroundColor: brandColor }]
        },
        options: { plugins: { legend: { display: false } } }
    });

    new Chart(document.getElementById('chartHta'), {
        type: 'doughnut',
        data: { labels: ['Sí','No'], datasets: [{ data: [62, 80], backgroundColor: [brandColor, accentColor] }] }
    });

    new Chart(document.getElementById('chartTa'), {
        type: 'bar',
        data: {
            labels: ['<100','100-110','110-120','120-130','130-140','>140'],
            datasets: [{ label: 'Pacientes', data: [8, 22, 41, 38, 25, 8], backgroundColor: brandColor }]
        },
        options: { plugins: { legend: { display: false } } }
    });
</script>
}
