@model ChequeAR.Api.Models.ReportStatsViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Estadísticas";
}

@* Esta pantalla era una maqueta: los numeros estaban escritos a mano en el .cshtml
   ('0-2','3-5', [12,23,41,...]) y los graficos venian de Chart.js por CDN. Ahora los
   calcula el backend sobre el grupo de fichas real del reporte guardado. *@

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">Estadísticas@(string.IsNullOrEmpty(Model.ReportName) ? "" : " · " + Model.ReportName)</h1>
        <p class="cq-page-header__subtitle">Completitud y distribución sobre el grupo de fichas</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index")" class="btn btn-neutral"><i class="bi bi-arrow-left me-1"></i>Volver</a>
        @if (Model.ReportId.HasValue)
        {
            <a href="@Url.Action("Preview", new { id = Model.ReportId })" class="btn btn-primary"><i class="bi bi-table me-1"></i> Ver tabla</a>
        }
    </div>
</header>

@if (!string.IsNullOrEmpty(ViewBag.DataError as string))
{
    <div class="alert alert-danger" role="alert">
        <strong>No se pudieron cargar los datos.</strong>
        <div class="small">@ViewBag.DataError</div>
    </div>
}
else if (string.IsNullOrEmpty(Model.QueryJson))
{
    <div class="cq-card">
        <div class="cq-empty">
            <div class="cq-empty__icon"><i class="bi bi-graph-up"></i></div>
            <div class="cq-empty__title">No hay ningún reporte que analizar</div>
            <div class="cq-empty__desc">Las estadísticas se calculan sobre un grupo de fichas. Arme un reporte y pida las estadísticas desde ahí.</div>
            <a href="@Url.Action("Build")" class="btn btn-primary">Nuevo reporte</a>
        </div>
    </div>
}
else
{
    @* Razor codifica el atributo: el nombre del reporte y los valores de los filtros los
       escribe el usuario, y con comillas simples + Html.Raw un apóstrofo cerraba el atributo. *@
    var statsProps = Newtonsoft.Json.JsonConvert.SerializeObject(new
    {
        autoQuery = new Newtonsoft.Json.Linq.JRaw(string.IsNullOrWhiteSpace(Model.QueryJson) ? "null" : Model.QueryJson),
        reportName = Model.ReportName ?? ""
    });
    <div data-vue-island="report-stats" data-props="@statsProps">
        <div class="cq-card">
            <div class="cq-loading">
                <div class="cq-spinner cq-spinner--lg"></div>
                <div class="cq-loading__label">Calculando estadísticas…</div>
            </div>
        </div>
    </div>
}

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/vue@3.4.31/dist/vue.global.prod.js"></script>
<script src="@Asset.Url("~/Scripts/islands/bootstrap.js")"></script>
<script src="@Asset.Url("~/Scripts/islands/report-stats/index.js")"></script>
}
