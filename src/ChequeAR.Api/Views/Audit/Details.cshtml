@using ChequeAR.Api.Helpers
@model ChequeAR.Api.Models.AuditDetailViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Evento #" + Model.Id;
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">Evento de auditoría</h1>
        <p class="cq-page-header__subtitle">@Model.Timestamp</p>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Volver</a>
</header>

<div class="cq-card" style="max-width:760px;">
    <dl class="row mb-0">
        <dt class="col-sm-3 cq-text-sm cq-text-muted">Cuándo</dt>      <dd class="col-sm-9">@Model.Timestamp</dd>
        <dt class="col-sm-3 cq-text-sm cq-text-muted">Usuario</dt>     <dd class="col-sm-9">@Model.Username · @Model.FullName</dd>
        <dt class="col-sm-3 cq-text-sm cq-text-muted">Rol / especialidad</dt><dd class="col-sm-9">@Model.Role · @Model.Specialty</dd>
        <dt class="col-sm-3 cq-text-sm cq-text-muted">Acción</dt>      <dd class="col-sm-9"><span class="cq-badge @Model.ActionBadge"><i class="bi @Model.ActionIcon me-1"></i>@Model.Action</span></dd>
        <dt class="col-sm-3 cq-text-sm cq-text-muted">Cuestionario</dt><dd class="col-sm-9">@Model.Resource</dd>
        <dt class="col-sm-3 cq-text-sm cq-text-muted">IP</dt>          <dd class="col-sm-9">@Model.IP</dd>
        <dt class="col-sm-3 cq-text-sm cq-text-muted">User-Agent</dt>  <dd class="col-sm-9 cq-text-sm">@Model.UserAgent</dd>
    </dl>
</div>

@if (Model.HasVersionDiff)
{
    <div class="cq-card mt-3">
        @if (Model.FromVersion.HasValue)
        {
            <h2 class="cq-section-title">CAMBIOS: VERSIÓN @Model.FromVersion → VERSIÓN @Model.ToVersion</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="cq-text-sm cq-text-muted mb-1">Versión @Model.FromVersion (antes)</div>
                    <pre class="cq-diff">@foreach (var l in Model.BeforeLines) {<text><span class="@(l.Change == AuditPresentation.Change.Removed ? "cq-diff__del" : null)">@l.Text</span>
</text>}</pre>
                </div>
                <div class="col-md-6">
                    <div class="cq-text-sm cq-text-muted mb-1">Versión @Model.ToVersion (después)</div>
                    <pre class="cq-diff">@foreach (var l in Model.AfterLines) {<text><span class="@(l.Change == AuditPresentation.Change.Added ? "cq-diff__add" : null)">@l.Text</span>
</text>}</pre>
                </div>
            </div>
        }
        else
        {
            <h2 class="cq-section-title">Versión inicial (v@(Model.ToVersion))</h2>
            <p class="cq-text-sm cq-text-muted">Primera versión publicada del cuestionario.</p>
            <pre class="cq-diff">@foreach (var l in Model.AfterLines) {<text><span class="cq-diff__add">@l.Text</span>
</text>}</pre>
        }
    </div>
}
