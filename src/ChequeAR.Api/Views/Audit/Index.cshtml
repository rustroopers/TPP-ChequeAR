@model ChequeAR.Api.Models.AuditListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Cq.T("audit.title");
    var pageSize = Model.PageSize > 0 ? Model.PageSize : 50;
    var totalPages = (int)Math.Ceiling((double)Model.Total / pageSize);
    var startIdx = (Model.Page - 1) * pageSize + 1;
    var endIdx = (Model.Page - 1) * pageSize + Model.Entries.Count;
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">@Cq.T("audit.title")</h1>
    </div>
    <div class="dropdown">
        <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-download me-1"></i> @Cq.T("common.export")
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="@Url.Action("Export", new { user = Model.UserFilter, act = Model.ActionFilter, type = Model.ResourceTypeFilter, from = Model.From, to = Model.To, format = "xlsx" })"><i class="bi bi-file-earmark-excel me-1"></i> Excel (.xlsx)</a></li>
            <li><a class="dropdown-item" href="@Url.Action("Export", new { user = Model.UserFilter, act = Model.ActionFilter, type = Model.ResourceTypeFilter, from = Model.From, to = Model.To, format = "csv" })"><i class="bi bi-filetype-csv me-1"></i> CSV (.csv)</a></li>
        </ul>
    </div>
</header>

@using (Html.BeginForm("Index", "Audit", FormMethod.Get, new { @class = "mb-3", data_cq_autofilter = "audit" }))
{
    <div class="row g-2 align-items-end">
        <div class="col-md-3"><label class="form-label cq-text-sm">Usuario</label><input type="text" class="form-control" name="user" value="@Model.UserFilter" /></div>
        <div class="col-md-2"><label class="form-label cq-text-sm">Acción</label>
            <select class="form-select" name="act">
                <option value="">Todas</option>
                <option value="R" selected="@(Model.ActionFilter == "R")">Consultas</option>
                <option value="C" selected="@(Model.ActionFilter == "C")">Creaciones</option>
                <option value="U" selected="@(Model.ActionFilter == "U")">Modificaciones</option>
                <option value="D" selected="@(Model.ActionFilter == "D")">Eliminaciones</option>
                <option value="E" selected="@(Model.ActionFilter == "E")">Exportaciones e ingresos</option>
            </select>
        </div>
        <div class="col-md-3"><label class="form-label cq-text-sm">Recurso</label>
            <select class="form-select" name="type">
                <option value="">Todos</option>
                @foreach (var t in ChequeAR.Api.Helpers.AuditPresentation.ResourceTypes)
                {
                    <option value="@t.Key" selected="@(Model.ResourceTypeFilter == t.Key)">@t.Value</option>
                }
            </select>
        </div>
        <div class="col-md-4"><label class="form-label cq-text-sm">Período</label>
            <cq-date-range name-from="from" name-to="to" value-from="@Model.From" value-to="@Model.To"></cq-date-range>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(ViewBag.ExportError as string))
{
    <div class="alert alert-warning" role="alert">@ViewBag.ExportError</div>
}

@if (Model.Entries.Count == 0)
{
    <div class="cq-card">
        <div class="cq-empty">
            <div class="cq-empty__icon"><i class="bi bi-clipboard-x"></i></div>
            @if (string.IsNullOrEmpty(Model.UserFilter) && string.IsNullOrEmpty(Model.ActionFilter) && string.IsNullOrEmpty(Model.ResourceTypeFilter)
                 && string.IsNullOrEmpty(Model.From) && string.IsNullOrEmpty(Model.To))
            {
                <div class="cq-empty__title">Sin eventos</div>
            }
            else
            {
                <div class="cq-empty__title">Ningún evento coincide con los filtros</div>
            }
        </div>
    </div>
}
else
{
    <table class="cq-table">
        <thead>
            <tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Recurso</th><th>Nombre</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Entries)
            {
                <tr>
                    <td class="cq-text-sm">@e.Timestamp</td>
                    <td>@e.Username</td>
                    <td><span class="cq-badge @e.ActionBadge"><i class="bi @e.ActionIcon me-1"></i>@e.Action</span></td>
                    <td>@e.Resource</td>
                    <td>@e.ResourceName</td>
                    <td class="text-end"><a href="@Url.Action("Details", new { id = e.Id })" class="btn btn-sm btn-tertiary">Ver →</a></td>
                </tr>
            }
        </tbody>
    </table>
    <div class="d-flex justify-content-between align-items-center mt-3 cq-text-sm cq-text-muted">
        <span>@startIdx-@endIdx de @Model.Total.ToString("N0")</span>
        @if (totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Url.Action("Index", new { user = Model.UserFilter, act = Model.ActionFilter, type = Model.ResourceTypeFilter, from = Model.From, to = Model.To, page = Model.Page - 1 })">‹</a></li>
                    <li class="page-item active"><span class="page-link">@Model.Page</span></li>
                    <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")"><a class="page-link" href="@Url.Action("Index", new { user = Model.UserFilter, act = Model.ActionFilter, type = Model.ResourceTypeFilter, from = Model.From, to = Model.To, page = Model.Page + 1 })">›</a></li>
                </ul>
            </nav>
        }
    </div>
}
