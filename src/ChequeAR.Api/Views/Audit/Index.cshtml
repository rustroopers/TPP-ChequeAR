@model ChequeAR.Api.Models.AuditListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Cq.T("audit.title");
    var pageSize = Model.PageSize > 0 ? Model.PageSize : 50;
    var totalPages = (int)Math.Ceiling((double)Model.Total / pageSize);
    var startIdx = (Model.Page - 1) * pageSize + 1;
    var endIdx = (Model.Page - 1) * pageSize + Model.Entries.Count;
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">@Cq.T("audit.title")</h1>
        <p class="cq-page-header__subtitle">@Cq.T("audit.subtitle")</p>
    </div>
    <a href="@Url.Action("Export", new { user = Model.UserFilter, act = Model.ActionFilter, resource = Model.ResourceFilter, from = Model.From, to = Model.To, format = "xlsx" })"
       class="btn btn-primary"><i class="bi bi-file-earmark-excel me-1"></i> @Cq.T("common.export")</a>
</header>

@using (Html.BeginForm("Index", "Audit", FormMethod.Get, new { @class = "mb-3", data_cq_autofilter = "audit" }))
{
    <div class="row g-2 align-items-end">
        <div class="col-md-3"><label class="form-label cq-text-sm">Usuario</label><input type="text" class="form-control" name="user" value="@Model.UserFilter" /></div>
        <div class="col-md-2"><label class="form-label cq-text-sm">Acción</label>
            <select class="form-select" name="act">
                <option value="">Todas</option>
                <option value="R" selected="@(Model.ActionFilter == "R")">Consultas</option>
                <option value="C" selected="@(Model.ActionFilter == "C")">Creaciones</option>
                <option value="U" selected="@(Model.ActionFilter == "U")">Modificaciones</option>
                <option value="D" selected="@(Model.ActionFilter == "D")">Eliminaciones</option>
                <option value="E" selected="@(Model.ActionFilter == "E")">Exportaciones</option>
            </select>
        </div>
        <div class="col-md-3"><label class="form-label cq-text-sm">Recurso</label><input type="text" class="form-control" name="resource" value="@Model.ResourceFilter" placeholder="Cuestionario…" /></div>
        <div class="col-md-4"><label class="form-label cq-text-sm">Período</label>
            <cq-date-range name-from="from" name-to="to" value-from="@Model.From" value-to="@Model.To"></cq-date-range>
        </div>
    </div>
}

@if (Model.Entries.Count == 0)
{
    <div class="cq-card">
        <div class="cq-empty">
            <div class="cq-empty__icon"><i class="bi bi-clipboard-x"></i></div>
            <div class="cq-empty__title">Sin eventos</div>
            <div class="cq-empty__desc">No hay registros de auditoría que coincidan con los filtros.</div>
        </div>
    </div>
}
else
{
    <table class="cq-table">
        <thead>
            <tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Cuestionario</th><th>IP</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Entries)
            {
                <tr>
                    <td class="cq-text-sm">@e.Timestamp</td>
                    <td>@e.Username</td>
                    <td><span class="cq-badge @e.ActionBadge"><i class="bi @e.ActionIcon me-1"></i>@e.Action</span></td>
                    <td>@e.Resource</td>
                    <td class="cq-text-sm cq-text-muted">@e.IP</td>
                    <td class="text-end"><a href="@Url.Action("Details", new { id = e.Id })" class="btn btn-sm btn-outline-secondary">Ver →</a></td>
                </tr>
            }
        </tbody>
    </table>
    <div class="d-flex justify-content-between align-items-center mt-3 cq-text-sm cq-text-muted">
        <span>@startIdx-@endIdx de @Model.Total.ToString("N0")</span>
        @if (totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Url.Action("Index", new { user = Model.UserFilter, act = Model.ActionFilter, resource = Model.ResourceFilter, from = Model.From, to = Model.To, page = Model.Page - 1 })">‹</a></li>
                    <li class="page-item active"><span class="page-link">@Model.Page</span></li>
                    <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")"><a class="page-link" href="@Url.Action("Index", new { user = Model.UserFilter, act = Model.ActionFilter, resource = Model.ResourceFilter, from = Model.From, to = Model.To, page = Model.Page + 1 })">›</a></li>
                </ul>
            </nav>
        }
    </div>
}
