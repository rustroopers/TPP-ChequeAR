@model ChequeAR.Api.Models.AuditListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Cq.T("audit.title");
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">@Cq.T("audit.title")</h1>
        <p class="cq-page-header__subtitle">@Cq.T("audit.subtitle")</p>
    </div>
    <button class="btn btn-outline-secondary"><i class="bi bi-download me-1"></i> @Cq.T("common.export")</button>
</header>

@using (Html.BeginForm("Index", "Audit", FormMethod.Get, new { @class = "mb-3" }))
{
    <div class="row g-2 align-items-end">
        <div class="col-md-3"><label class="form-label cq-text-sm">Usuario</label><input type="text" class="form-control" name="user" value="@Model.UserFilter" /></div>
        <div class="col-md-2"><label class="form-label cq-text-sm">Acción</label>
            <select class="form-select" name="action">
                <option value="">Todas</option>
                <option value="R">Consultas</option>
                <option value="C">Creaciones</option>
                <option value="U">Modificaciones</option>
                <option value="D">Eliminaciones</option>
                <option value="E">Exportaciones</option>
            </select>
        </div>
        <div class="col-md-2"><label class="form-label cq-text-sm">Recurso</label><input type="text" class="form-control" name="resource" value="@Model.ResourceFilter" placeholder="Cuestionario…" /></div>
        <div class="col-md-2"><label class="form-label cq-text-sm">Desde</label><input type="date" class="form-control" name="from" value="@Model.From" /></div>
        <div class="col-md-2"><label class="form-label cq-text-sm">Hasta</label><input type="date" class="form-control" name="to" value="@Model.To" /></div>
        <div class="col-md-1"><button type="submit" class="btn btn-outline-secondary w-100">Filtrar</button></div>
    </div>
}

<table class="cq-table">
    <thead>
        <tr><th>Fecha/hora (ARG)</th><th>Usuario</th><th>Acción</th><th>Cuestionario</th><th>IP</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var e in Model.Entries)
        {
            <tr>
                <td class="cq-text-sm">@e.Timestamp</td>
                <td>@e.Username</td>
                <td><span class="cq-badge cq-badge--icon @e.ActionBadge"><i class="bi @e.ActionIcon me-1"></i>@e.Action</span></td>
                <td>@e.Resource</td>
                <td class="cq-text-sm cq-text-muted">@e.IP</td>
                <td class="text-end"><a href="@Url.Action("Details", new { id = e.Id })" class="btn btn-sm btn-outline-secondary">Ver →</a></td>
            </tr>
        }
    </tbody>
</table>
<div class="cq-text-sm cq-text-muted mt-3">1-@Model.Entries.Count de @Model.Total.ToString("N0")</div>
