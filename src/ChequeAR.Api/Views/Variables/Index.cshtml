@model ChequeAR.Api.Models.VariableListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Cq.T("variables.title");
    var pageSize = Model.PageSize > 0 ? Model.PageSize : 20;
    var totalPages = (int)Math.Ceiling((double)Model.Total / pageSize);
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">@Cq.T("variables.title")</h1>
    </div>
    <a href="@Url.Action("Details")" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> @Cq.T("variables.new")</a>
</header>

@* Mismo formulario que el listado de cuestionarios: sin botón, cq-autofilter lo re-envía
   a medida que se escribe o se cambia un filtro. *@
@using (Html.BeginForm("Index", "Variables", FormMethod.Get, new { @class = "mb-3", data_cq_autofilter = "variables" }))
{
    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label cq-text-sm">Buscar</label>
            @* Un solo campo: el servidor matchea contra nombre, código y concepto SNOMED. *@
            <input type="search" name="q" value="@Model.SearchTerm" class="form-control"
                   placeholder="Nombre, código o concepto SNOMED…" />
        </div>
        <div class="col-md-3">
            <label class="form-label cq-text-sm">Tipo</label>
            <select name="type" class="form-select">
                <option value="">Todos</option>
                @foreach (var t in new[] {
                    Tuple.Create("decimal", "Número decimal"), Tuple.Create("integer", "Número entero"),
                    Tuple.Create("string", "Texto corto"), Tuple.Create("text", "Texto largo"),
                    Tuple.Create("boolean", "Sí / No"), Tuple.Create("choice", "Opción única"),
                    Tuple.Create("openChoice", "Opción múltiple"), Tuple.Create("date", "Fecha"),
                    Tuple.Create("dateTime", "Fecha y hora"), Tuple.Create("attachment", "Adjunto"),
                    Tuple.Create("scale", "Escala") })
                {
                    <option value="@t.Item1" selected="@(Model.TypeFilter == t.Item1)">@t.Item2</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label cq-text-sm">Estado</label>
            <select name="status" class="form-select">
                <option value="">Todos</option>
                <option value="active" selected="@(Model.StatusFilter == "active")">Activa</option>
                <option value="inactive" selected="@(Model.StatusFilter == "inactive")">De baja</option>
            </select>
        </div>
    </div>
}

@if (Model.Variables.Count == 0)
{
    <div class="cq-card cq-card--stretch">
        <div class="cq-empty">
            <div class="cq-empty__icon"><i class="bi bi-tags"></i></div>
            @if (string.IsNullOrEmpty(Model.SearchTerm) && string.IsNullOrEmpty(Model.TypeFilter) && string.IsNullOrEmpty(Model.StatusFilter))
            {
                <div class="cq-empty__title">@Cq.T("variables.empty.title")</div>
            }
            else
            {
                <div class="cq-empty__title">@Cq.T("variables.empty.filtered")</div>
            }
        </div>
    </div>
}
else
{
    <table class="cq-table">
        <thead>
            <tr>
                <th>Nombre</th><th>Código</th><th>Tipo</th><th>Unidad</th>
                <th>Rango</th><th>SNOMED CT</th><th>Estado</th>
                <th>Creada <i class="bi bi-arrow-down" aria-hidden="true"></i></th>
                <th class="text-end">@Cq.T("table.col.actions")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in Model.Variables)
            {
                <tr class="cq-row--clickable" data-href="@Url.Action("Details", new { id = v.Id })">
                    <td><a href="@Url.Action("Details", new { id = v.Id })" class="text-decoration-none fw-semibold">@v.Name</a></td>
                    <td><code>@v.Code</code></td>
                    <td class="cq-text-sm">@v.TypeLabel</td>
                    <td class="cq-text-sm">@(v.Unit ?? "—")</td>
                    <td class="cq-text-sm">@(v.Range ?? "—")</td>
                    <td class="cq-text-sm">
                        @if (string.IsNullOrEmpty(v.SnomedCode))
                        {
                            <span class="cq-text-muted">Sin codificar</span>
                        }
                        else
                        {
                            <code>@v.SnomedCode</code><br />
                            <span class="cq-text-xs cq-text-muted">@v.SnomedDisplay</span>
                        }
                    </td>
                    <td>
                        @if (!v.IsPublished) { <span class="cq-badge cq-badge--draft">Sin publicar</span> }
                        else if (v.IsActive) { <span class="cq-badge cq-badge--published">Activa</span> }
                        else { <span class="cq-badge cq-badge--archived">De baja</span> }
                        @if (v.ReplacedByName != null) { <span class="cq-badge cq-badge--info mt-1" style="width:fit-content;display:flex;" title="Reemplazada por @v.ReplacedByName">Reemplazada</span> }
                    </td>
                    <td class="cq-text-sm cq-text-muted">@v.CreatedAt</td>
                    <td class="text-end">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-tertiary" data-bs-toggle="dropdown" aria-label="Acciones de @v.Name" title="Acciones">
                                <i class="bi bi-three-dots"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="@Url.Action("Details", new { id = v.Id })"><i class="bi bi-pencil me-1"></i> Editar</a></li>
                                @if (!v.IsPublished)
                                {
                                    <li><button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#publishModal" data-id="@v.Id" data-revision="@v.Revision" data-title="@v.Name" data-replaces="@v.ReplacesName"><i class="bi bi-send me-1"></i> Publicar</button></li>
                                }
                                else
                                {
                                    <li><a class="dropdown-item" href="@Url.Action("Details", new { from = v.Id })"><i class="bi bi-plus-lg me-1"></i> Crear a partir de esta</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                @if (v.IsActive)
                                {
                                    @* Una variable que nunca se publicó no puede estar en uso: el servicio la borra. *@
                                    <li><button class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@v.Id" data-title="@v.Name" data-delete="@(!v.IsPublished ? "true" : "false")"><i class="bi bi-trash me-1"></i> @(!v.IsPublished ? "Eliminar" : "Dar de baja")</button></li>
                                }
                                else
                                {
                                    <li>
                                        @using (Html.BeginForm("Activate", "Variables", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@v.Id" />
                                            <button type="submit" class="dropdown-item"><i class="bi bi-arrow-counterclockwise me-1"></i> Reactivar</button>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="d-flex justify-content-between align-items-center mt-3 cq-text-sm cq-text-muted">
        <span>Mostrando @Model.Variables.Count de @Model.Total</span>
        @if (totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Url.Action("Index", new { q = Model.SearchTerm, type = Model.TypeFilter, status = Model.StatusFilter, page = Model.Page - 1 })">‹</a></li>
                    <li class="page-item active"><span class="page-link">@Model.Page</span></li>
                    <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")"><a class="page-link" href="@Url.Action("Index", new { q = Model.SearchTerm, type = Model.TypeFilter, status = Model.StatusFilter, page = Model.Page + 1 })">›</a></li>
                </ul>
            </nav>
        }
    </div>
}

@* Modal Dar de baja / Eliminar. El servicio decide si borra o desactiva según esté publicada
   o en uso; el texto se ajusta a lo que va a pasar. *@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        @using (Html.BeginForm("Delete", "Variables", FormMethod.Post, new { @class = "modal-content" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteId" />
            <div class="modal-header">
                <h2 class="modal-title h3" id="deleteModalLabel"><span class="js-delete-verb">Dar de baja</span> variable</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">¿Quiere <span id="deleteVerbLower">dar de baja</span> <strong id="deleteTitle"></strong>?</p>
                <p class="cq-text-sm cq-text-muted mb-0 mt-2" id="deleteHint">Dejará de ofrecerse para cuestionarios nuevos.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger js-delete-verb">Dar de baja</button>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="publishModal" tabindex="-1" aria-labelledby="publishModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        @using (Html.BeginForm("Publish", "Variables", FormMethod.Post, new { @class = "modal-content" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="publishId" />
            <input type="hidden" name="revision" id="publishRevision" />
            <input type="hidden" name="returnUrl" value="@Request.RawUrl" />
            <div class="modal-header">
                <h2 class="modal-title h3" id="publishModalLabel">Publicar <span id="publishTitle"></span></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="publishReplaces" hidden>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="deactivateReplaced" value="true" id="deactivateReplaced" checked />
                    <label class="form-check-label" for="deactivateReplaced">Dar de baja &laquo;<span id="publishReplacesName"></span>&raquo;</label>
                </div>
                <p class="cq-text-sm cq-text-muted mb-0 mt-2">Dejará de ofrecerse para cuestionarios nuevos. Los que ya la usan no cambian.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Publicar</button>
            </div>
        }
    </div>
</div>

@section scripts {
<script>
    document.addEventListener("click", function (e) {
        var pub = e.target.closest("[data-bs-target='#publishModal']");
        if (!pub) return;
        document.getElementById("publishId").value = pub.getAttribute("data-id");
        document.getElementById("publishRevision").value = pub.getAttribute("data-revision");
        document.getElementById("publishTitle").textContent = pub.getAttribute("data-title");
        var anterior = pub.getAttribute("data-replaces");
        var chk = document.getElementById("deactivateReplaced");
        document.getElementById("publishReplaces").hidden = !anterior;
        document.getElementById("publishReplacesName").textContent = anterior || "";
        chk.disabled = !anterior;
        chk.checked = true;
    });

    document.addEventListener("click", function (e) {
        var btn = e.target.closest("[data-bs-target='#deleteModal']");
        if (!btn) return;
        document.getElementById("deleteId").value = btn.getAttribute("data-id");
        document.getElementById("deleteTitle").textContent = btn.getAttribute("data-title");
        var borra = btn.getAttribute("data-delete") === "true";
        document.querySelectorAll(".js-delete-verb").forEach(function (el) { el.textContent = borra ? "Eliminar" : "Dar de baja"; });
        document.getElementById("deleteVerbLower").textContent = borra ? "eliminar" : "dar de baja";
        document.getElementById("deleteHint").hidden = borra;
    });

    // Fila entera clickeable, como en cuestionarios. Se ignora si el click salió del menú.
    document.addEventListener("click", function (e) {
        var row = e.target.closest("tr.cq-row--clickable");
        if (!row) return;
        if (e.target.closest("a, button, .dropdown, .dropdown-menu, input, label, form")) return;
        var href = row.getAttribute("data-href");
        if (href) window.location.href = href;
    });
</script>
}
