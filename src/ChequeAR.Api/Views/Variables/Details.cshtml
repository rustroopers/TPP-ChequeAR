@model ChequeAR.Api.Models.VariableFormViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool esNueva = !Model.Id.HasValue;
    ViewBag.Title = esNueva ? "Nueva variable" : "Editar variable";
    string props = ViewBag.VariableProps as string;

    string subtitle = null;
    if (!esNueva)
    {
        if (!Model.IsActive)
        {
            subtitle = "De baja";
        }
        else if (Model.CurrentVersion == 0)
        {
            subtitle = "Sin publicar";
        }
        else if (Model.HasUnpublishedChanges)
        {
            subtitle = "Publicada · con cambios sin publicar";
        }
        else
        {
            subtitle = "Publicada";
        }
    }
}

<header class="cq-page-header">
    <div>
        <h1 class="cq-page-header__title">@(esNueva || string.IsNullOrWhiteSpace(Model.Name) ? (string)ViewBag.Title : Model.Name)</h1>
        @if (subtitle != null)
        {
            <p class="cq-page-header__subtitle">@subtitle</p>
        }
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index")" class="btn btn-neutral"><i class="bi bi-arrow-left me-1"></i>Volver</a>
        <button type="submit" form="variableForm" class="btn btn-secondary" id="saveBtn"><i class="bi bi-check2 me-1"></i> Guardar</button>
        @if (!esNueva)
        {
            <button type="button" class="btn btn-primary" id="publishBtn" data-bs-toggle="modal" data-bs-target="#publishModal" @(Model.CurrentVersion == 0 || Model.HasUnpublishedChanges ? "data-pending" : "disabled") @(ViewBag.VariableUnsaved == true ? "data-unsaved" : "")><i class="bi bi-send me-1"></i> Publicar</button>
        }
    </div>
</header>

@using (Html.BeginForm("Save", "Variables", FormMethod.Post, new { id = "variableForm" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    @* La isla renderiza el formulario y escribe el modelo completo en este hidden. Va dentro
       del form MVC -y no posteando por fetch- para conservar el antiforgery, el
       TempData["Toast"] y el redirect del resto de las pantallas de administración. *@
    <input type="hidden" name="PayloadJson" id="variablePayload" />

    <div id="variableForm-island" data-vue-island="variable-form" data-props="@props">
        <div class="cq-card">
            <div class="cq-loading">
                <div class="cq-spinner cq-spinner--lg"></div>
                <div class="cq-loading__label">@Cq.T("common.loading")</div>
            </div>
        </div>
    </div>
}

@if (!esNueva && Model.Versions.Count > 0)
{
    <div class="cq-card mt-3">
        <h2 class="h3">Versiones</h2>
        <table class="cq-table">
            <thead>
                <tr><th>Versión</th><th>Fecha</th><th>Autor</th><th>Estado</th><th>Notas</th></tr>
            </thead>
            <tbody>
                @foreach (var v in Model.Versions)
                {
                    <tr>
                        <td><strong>v@(v.Version)</strong></td>
                        <td class="cq-text-sm">@v.Date</td>
                        <td class="cq-text-sm">@v.Author</td>
                        <td>
                            @if (v.IsCurrent) { <span class="cq-badge cq-badge--published">Vigente</span> }
                            else { <span class="cq-badge cq-badge--archived">Anterior</span> }
                        </td>
                        <td class="cq-text-sm cq-text-muted">@v.ChangeNote</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!esNueva)
{
    <div class="modal fade" id="publishModal" tabindex="-1" aria-labelledby="publishModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            @using (Html.BeginForm("Publish", "Variables", FormMethod.Post, new { @class = "modal-content", id = "publishForm" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="revision" value="@Model.Revision" />
                <input type="hidden" name="payloadJson" id="publishPayload" />
                <div class="modal-header">
                    <h2 class="modal-title h3" id="publishModalLabel">Publicar variable</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Notas del cambio</label>
                    <textarea name="changeNote" rows="3" class="form-control" placeholder="Describa qué cambia respecto a la versión anterior"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Publicar</button>
                </div>
            }
        </div>
    </div>
}

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/vue@3.4.31/dist/vue.global.prod.js" integrity="sha384-V51X2t6rrCZupAhpkTcJvJMv6DQhFAxxMsb3vBXigj/RoxwsbZbQqwWg5aMX0XHQ" crossorigin="anonymous"></script>
<script src="@Asset.Url("~/Scripts/islands/bootstrap.js")"></script>
<script src="@Asset.Url("~/Scripts/islands/shared/snomed.js")"></script>
<script src="@Asset.Url("~/Scripts/islands/variable-form/index.js")"></script>
<script>
    document.getElementById('publishForm')?.addEventListener('submit', function () {
        document.getElementById('publishPayload').value = document.getElementById('variablePayload').value;
    });
</script>
}
