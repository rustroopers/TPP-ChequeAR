<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net471</TargetFramework>
    <RootNamespace>ChequeAR.Tests</RootNamespace>
    <AssemblyName>ChequeAR.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    Cobertura con coverlet.msbuild (no coverlet.collector): expone el umbral como
    propiedades de MSBuild, asi que `dotnet test -p:CollectCoverage=true` falla solo
    si no se llega al minimo, sin script aparte que parsee un reporte.
    Include limita el conteo a Domain/Application (lo unico que este proyecto puede
    referenciar, FR-021) para no contar de paso Hl7.Fhir.*, Newtonsoft.Json, etc.
  -->
  <PropertyGroup>
    <Include>[ChequeAR.Domain]*,[ChequeAR.Application]*</Include>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <ThresholdType>line,branch</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
    <Threshold>85,75</Threshold>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.4" />
    <!-- Para assertear sobre POCOs de Firely en vez de sobre JSON crudo. -->
    <PackageReference Include="Hl7.Fhir.R5" Version="5.13.4" />
    <!-- Ejecuta el enable-when.js del renderer para compararlo con EnableWhenEvaluator. -->
    <PackageReference Include="Jint" Version="3.1.6" />
  </ItemGroup>

  <!--
    NO agregar ProjectReference a ChequeAR.Infrastructure ni ChequeAR.Api.
    Que este proyecto no compile contra esas capas es la evidencia del aislamiento
    que afirma el documento de arquitectura (FR-021). Si una prueba parece
    necesitarlas, la que esta mal ubicada es la logica, no la prueba.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ChequeAR.Domain\ChequeAR.Domain.csproj" />
    <ProjectReference Include="..\ChequeAR.Application\ChequeAR.Application.csproj" />
  </ItemGroup>

</Project>
